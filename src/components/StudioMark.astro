---
// Geometric SNX studio mark — strokes itself on first paint.
// Sits absolutely positioned; parent decides where.
---

<div class="studio-mark" aria-hidden="true">
  <svg viewBox="0 0 360 360" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g class="sm-group">
      <!-- Outer ring -->
      <circle class="sm-stroke sm-circle" cx="180" cy="180" r="152"/>

      <!-- Inner ring -->
      <circle class="sm-stroke sm-circle-2" cx="180" cy="180" r="120"/>

      <!-- The crossing X -->
      <path class="sm-stroke sm-x" d="M 104 104 L 256 256"/>
      <path class="sm-stroke sm-x" d="M 256 104 L 104 256"/>

      <!-- Crosshair tick marks at the cardinal points -->
      <g class="sm-ticks">
        <path class="sm-stroke sm-tick" d="M 180 8  L 180 24"/>
        <path class="sm-stroke sm-tick" d="M 180 336 L 180 352"/>
        <path class="sm-stroke sm-tick" d="M 8 180  L 24 180"/>
        <path class="sm-stroke sm-tick" d="M 336 180 L 352 180"/>
      </g>

      <!-- N° serial top-left -->
      <text class="sm-serial" x="54" y="80"
            font-family="JetBrains Mono, ui-monospace, monospace"
            font-size="14" letter-spacing="2" fill="currentColor">N°XII</text>

      <!-- est. bottom-right -->
      <text class="sm-serial" x="226" y="312"
            font-family="JetBrains Mono, ui-monospace, monospace"
            font-size="13" letter-spacing="2" fill="currentColor">EST · 2024</text>

      <!-- Center dot -->
      <circle class="sm-dot" cx="180" cy="180" r="6" fill="var(--accent)"/>
    </g>
  </svg>
</div>

<style>
  .studio-mark {
    width: 100%;
    height: 100%;
    color: var(--ink);
    transform-origin: center;
  }
  .studio-mark svg { width: 100%; height: 100%; display: block; }

  /* Stroke-draw setup — every path gets dasharray + offset */
  .sm-stroke {
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: smDraw 1.6s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .sm-circle    { stroke-width: 2; opacity: 0.85; animation-delay: 0.05s; }
  .sm-circle-2  { stroke-width: 1; opacity: 0.3; animation-delay: 0.4s; }
  .sm-x         { stroke: var(--accent); stroke-width: 4; animation-delay: 0.8s; animation-duration: 1.1s; }
  .sm-tick      { stroke-width: 2; stroke-dasharray: 30; stroke-dashoffset: 30; animation: smDraw 0.5s ease-out forwards; }
  .sm-ticks .sm-tick:nth-child(1) { animation-delay: 1.6s; }
  .sm-ticks .sm-tick:nth-child(2) { animation-delay: 1.7s; }
  .sm-ticks .sm-tick:nth-child(3) { animation-delay: 1.8s; }
  .sm-ticks .sm-tick:nth-child(4) { animation-delay: 1.9s; }

  .sm-serial { opacity: 0; fill: var(--muted); animation: smFade 0.6s ease-out 2.0s forwards; }
  .sm-dot    { opacity: 0; transform: scale(0.4); transform-origin: 180px 180px; animation: smPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.6s forwards; }

  @keyframes smDraw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes smFade {
    to { opacity: 1; }
  }
  @keyframes smPop {
    to { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sm-stroke { stroke-dashoffset: 0; animation: none; }
    .sm-serial, .sm-dot { opacity: 1; transform: none; animation: none; }
  }
</style>
