---
import Mark from '../Marks.astro';
---

<section class="cta section bg-deep" id="contact-cta">
  <div class="container cta-inner">
    <div class="cta-meta">
      <span class="label label-mark">Direct reply</span>
      <span class="cta-meta-text">
        Within one working day. From a real human.
      </span>
    </div>

    <h2 class="cta-headline reveal">
      Have something
      <span class="cta-circled">
        <span class="cta-accent">non-trivial</span>
      </span>
      <br/>
      to <span class="accent">build?</span>
    </h2>

    <p class="cta-lede reveal">
      A small number of partnerships open at any time — usually one ambitious AI build,
      one platform engagement, and a UX teardown or two. Tell us where you are.
    </p>

    <div class="cta-actions reveal">
      <a href="mailto:hello@wearesnx.studio" class="cta-btn-primary">
        hello@wearesnx.studio
        <Mark name="arrow-r" class="cta-arrow" />
      </a>
      <a href="/contact" class="cta-btn-ghost">
        <span>Or send a detailed brief</span>
        <Mark name="arrow-r" class="cta-arrow-small" />
      </a>
    </div>

    <!-- Audiences block -->
    <div class="cta-audiences">
      <div class="cta-receipt-row">
        <div class="cta-receipt-col">
          <span class="cta-col-label">For founders</span>
          <span class="cta-col-text">
            Architecture reviews, technical DD,<br/>
            and senior engineering perspective.
          </span>
        </div>
        <div class="cta-receipt-col">
          <span class="cta-col-label">For product teams</span>
          <span class="cta-col-text">
            AI features that ship,<br/>
            design systems that hold up.
          </span>
        </div>
        <div class="cta-receipt-col">
          <span class="cta-col-label">For investors</span>
          <span class="cta-col-text">
            Independent technical due<br/>
            diligence on portfolio bets.
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    max-width: 1100px;
  }

  .cta-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .cta-meta-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .cta-headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.75rem, 8vw, 7rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin-bottom: 2rem;
    text-wrap: balance;
  }
  .cta-headline .accent { color: var(--accent); }

  .cta-circled {
    display: inline-block;
    padding: 0 0.18em;
  }
  .cta-accent { color: var(--accent); }

  .cta-lede {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 620px;
    margin-bottom: 2.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 1.5rem 1rem 1.75rem;
    background: var(--accent);
    color: #050506;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0;
    border: 1px solid var(--accent);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .cta-btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
  .cta-arrow { width: 32px; height: 14px; }

  .cta-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--border-strong);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0;
    background: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .cta-btn-ghost:hover { background: var(--bg-alt); border-color: var(--border-strong); }
  .cta-arrow-small { width: 24px; height: 12px; }

  /* Audiences block */
  .cta-audiences {
    background: var(--bg-alt);
    padding: 2rem 1.75rem;
    border: 1px solid var(--border);
  }
  .cta-receipt-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .cta-receipt-col { display: flex; flex-direction: column; gap: 0.5rem; }
  .cta-col-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cta-col-text {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  @media (max-width: 768px) {
    .cta-receipt-row { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
