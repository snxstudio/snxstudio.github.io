---
import Mark from '../Marks.astro';

const projects = [
  {
    idx: '01',
    title: 'Maritime Routing Engine',
    sector: 'Open Source · Geospatial · TypeScript',
    year: '2022 — Now',
    role: 'Author & maintainer',
    stamp: 'MIT · in the wild',
    summary: 'searoute-ts — the shortest realistic sea route between any two points on Earth. Eurostat network, canal and strait restrictions, vessel-draft gating, ETA from speed.',
    metrics: [
      { value: '13.4k', label: 'npm downloads / month' },
      { value: 'MIT', label: 'Free, forever' },
      { value: '2022', label: 'Maintained since' },
    ],
    stack: ['TypeScript', 'GeoJSON', 'Eurostat network', 'npm', 'GitHub Actions'],
    link: 'https://github.com/mayurrawte/searoute-ts',
    external: true,
  },
  {
    idx: '02',
    title: 'Teamsly',
    sector: 'Product · MCP · Microsoft Graph',
    year: '2026 — Now',
    role: 'Author & maintainer',
    stamp: 'Open & self-hostable',
    summary: 'A keyboard-first Microsoft Teams client on the Graph API — AI summaries, voice rooms, disappearing DMs — with an MCP server so Claude and Cursor can use Teams as a tool.',
    metrics: [
      { value: 'MCP', label: 'Native Claude & Cursor tools' },
      { value: 'Graph', label: 'Direct Microsoft API' },
      { value: 'OSS', label: 'Self-hostable' },
    ],
    stack: ['TypeScript', 'Next.js', 'Electron', 'Microsoft Graph', 'MCP'],
    link: 'https://teamsly.app/',
    external: true,
  },
  {
    idx: '03',
    title: 'Lit Pigeon',
    sector: 'Developer Platform · Web Components',
    year: '2026 — Now',
    role: 'Author & maintainer',
    stamp: 'MIT · 14 packages',
    summary: 'A drag-and-drop email editor built once as web components, with wrappers for React, Vue, Angular and Svelte. MJML in and out, pre-flight linting, Figma import, MCP server.',
    metrics: [
      { value: '14', label: 'npm packages, MIT' },
      { value: '5', label: 'Frameworks supported' },
      { value: 'MJML', label: 'Parse, render, lint' },
    ],
    stack: ['TypeScript', 'Lit', 'MJML', 'React / Vue / Angular', 'MCP'],
    link: 'https://github.com/snxstudio/lit-pigeon',
    external: true,
  },
  {
    idx: '04',
    title: 'mcp-elements',
    sector: 'Design System · MCP · Multi-framework',
    year: '2026 — Now',
    role: 'Author & maintainer',
    stamp: 'MIT · copy-paste',
    summary: 'Copy-paste UI for AI apps — tool-call cards, OAuth consent, scope inspectors, JSON-Schema tool forms. 38 components across React, Vue and Angular over one shared core.',
    metrics: [
      { value: '38', label: 'Components' },
      { value: '3', label: 'Frameworks, one core' },
      { value: 'MIT', label: 'No lock-in' },
    ],
    stack: ['TypeScript', 'React', 'Vue', 'Angular', 'Tailwind v4'],
    link: 'https://github.com/mcp-elements/ui',
    external: true,
  },
  {
    idx: '05',
    title: 'Promptbucket',
    sector: 'Open Source · AI · Web app',
    year: '2025 — Now',
    role: 'Designer & maintainer',
    stamp: 'Open & free',
    summary: 'promptbucket.co — an open library for collecting, versioning, and sharing prompts that actually survive contact with production. Built for the working AI engineer.',
    metrics: [
      { value: 'Free', label: 'Open to anyone' },
      { value: 'OSS', label: 'Hosted on GitHub' },
      { value: 'v1', label: 'Live & shipping' },
    ],
    stack: ['Next.js', 'Anthropic SDK', 'Tailwind', 'Postgres', 'Vercel'],
    link: 'https://promptbucket.co',
    external: true,
  },
  {
    idx: '06',
    title: 'ELIOT — Smart Energy Telemetry',
    sector: 'Industrial IoT · Embedded · Research',
    year: '2017 — 2019',
    role: 'Lead engineer & co-author',
    stamp: 'Ministry recognised',
    summary: 'A drop-in prepaid meter that reads an existing analogue meter by its pulse LED and reports over MQTT. Published in IJCA; recognised by the Ministry of Power & Coal.',
    metrics: [
      { value: 'IJCA', label: 'Peer-reviewed, Aug 2017' },
      { value: 'MoP', label: 'Ministry recognition' },
      { value: 'SIH', label: '2nd Runner-up, 2018' },
    ],
    stack: ['Embedded C', 'NodeMCU / ESP8266', 'Lua', 'MQTT', 'TypeScript'],
    link: '/work',
  },
];
---

<section class="work section bg-surface-alt" id="selected-work">
  <div class="container-wide">
    <header class="work-header">
      <span class="label label-mark">Selected work</span>
      <h2 class="work-h2">
        Things that
        <span class="work-h2-accent">actually</span>
        shipped<span class="work-h2-dot">.</span>
      </h2>
      <p class="work-sub">
        A working studio doesn't get the luxury of vapourware. Every project below ran in
        production, served real users, and survived the messy bit after launch.
      </p>
    </header>

    <ol class="work-list" role="list" id="work-list">
      {projects.map((p) => (
        <li class="work-row reveal">
          <article class="work-card">
            <a
              href={p.link}
              target={p.external ? '_blank' : undefined}
              rel={p.external ? 'noopener noreferrer' : undefined}
              class="work-link"
            >
              <!-- Top metadata row -->
              <div class="work-row-top">
                <span class="work-folder-tab">
                  <span class="work-idx numeral">{p.idx}</span>
                  <span class="work-folder-rule"></span>
                  <span class="work-sector">{p.sector}</span>
                </span>
                <span class="work-row-meta">
                  <span>{p.year}</span>
                  <span class="work-row-meta-dot">·</span>
                  <span class="work-role">{p.role}</span>
                </span>
              </div>

              <!-- Body -->
              <div class="work-body">
                <div class="work-content">
                  <div class="work-title-row">
                    <h3 class="work-title">
                      {p.title}
                      {p.external && (
                        <span class="work-ext" aria-hidden="true">
                          <Mark name="arrow-r" />
                        </span>
                      )}
                    </h3>
                    <span class="work-stamp stamp">{p.stamp}</span>
                  </div>

                  <p class="work-summary">{p.summary}</p>

                  <div class="work-row-bottom">
                    <ul class="work-metrics" role="list">
                      {p.metrics.map(m => (
                        <li>
                          <span class="metric-val numeral">{m.value}</span>
                          <span class="metric-label">{m.label}</span>
                        </li>
                      ))}
                    </ul>
                    <ul class="work-stack" role="list">
                      {p.stack.map(s => <li>{s}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </a>
          </article>
        </li>
      ))}
    </ol>

    <footer class="work-footer reveal">
      <p class="work-footer-text">
        <span class="work-footer-lead">More in the archive</span> — open-source repos,
        smaller commissions, and teardown essays.
      </p>
      <div class="work-footer-actions">
        <a href="/work" class="btn-ghost">Full archive</a>
        <a href="/opensource" class="btn-ghost">Open source</a>
      </div>
    </footer>
  </div>
</section>

<style>
  .work { color: var(--ink); }

  .work-header {
    max-width: 880px;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .work-h2 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .work-h2-dot { color: var(--accent); }
  .work-h2-accent { color: var(--accent); }
  .work-sub {
    font-size: clamp(1.125rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 620px;
  }

  /* List */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .work-row { position: relative; }

  .work-card {
    position: relative;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 0;
    transition: border-color 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .work-row:hover .work-card {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .work-link {
    display: block;
    padding: clamp(2rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem);
    color: var(--ink);
  }

  /* Body */
  .work-body { display: block; }
  .work-content { min-width: 0; }

  /* Metadata top */
  .work-row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .work-folder-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .work-idx {
    color: var(--accent);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .work-folder-rule { width: 28px; height: 1px; background: var(--accent); }

  .work-row-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .work-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .work-row-meta-dot { color: var(--accent); }

  /* Title + stamp */
  .work-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.875rem, 4.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .work-row:hover .work-title { color: var(--accent); }
  .work-ext {
    color: var(--accent);
    width: 56px;
    height: 18px;
    transform: translateY(-0.1em);
  }

  .work-stamp {
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 0.4rem;
  }

  .work-summary {
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 760px;
    margin-bottom: 1.5rem;
  }

  .work-row-bottom {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: end;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .work-metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .work-metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border-right: 1px solid var(--border);
  }
  .work-metrics li:last-child { border-right: none; }
  .metric-val {
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    color: var(--ink);
    line-height: 1;
  }
  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .work-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-self: end;
  }
  .work-stack li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 0;
  }

  .work-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    flex-wrap: wrap;
  }
  .work-footer-text {
    font-size: 1.125rem;
    color: var(--ink-2);
    max-width: 460px;
  }
  .work-footer-lead {
    color: var(--ink);
    font-weight: 600;
  }
  .work-footer-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 880px) {
    .work-row-bottom {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .work-stack { justify-self: start; }
  }

  @media (max-width: 560px) {
    .work-metrics { grid-template-columns: 1fr 1fr; }
    .work-metrics li:nth-child(2) { border-right: none; }
    .work-metrics li:last-child {
      grid-column: 1 / -1;
      border-top: 1px solid var(--border);
    }
  }
</style>
