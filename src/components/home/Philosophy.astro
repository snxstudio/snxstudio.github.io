---
import Mark from '../Marks.astro';
---

<section class="philosophy section" id="philosophy">
  <div class="container">
    <div class="philosophy-stage">
      <span class="quote-mark quote-mark-open" aria-hidden="true">&ldquo;</span>

      <blockquote class="philosophy-quote reveal">
        <p>
          The best technology
          <span class="phil-accent">disappears.</span>
          It doesn't announce itself with novelty or noise — it simply does the work,
          precisely as intended,
          <span class="phil-soft">leaving people the room to think.</span>
        </p>
        <footer class="philosophy-cite">
          <Mark name="cross" class="cite-mark" />
          <span class="cite-text">Studio note · written between two production deploys</span>
        </footer>
      </blockquote>

      <span class="quote-mark quote-mark-close" aria-hidden="true">&rdquo;</span>
    </div>
  </div>
</section>

<style>
  .philosophy {
    position: relative;
    overflow: hidden;
    background-color: var(--bg);
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }

  .philosophy-stage {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* Oversized quote marks — crisp, upright */
  .quote-mark {
    position: absolute;
    font-family: var(--font-display);
    font-size: clamp(8rem, 18vw, 16rem);
    line-height: 0.6;
    color: var(--accent);
    user-select: none;
    pointer-events: none;
  }
  .quote-mark-open {
    top: -0.15em;
    left: -0.15em;
  }
  .quote-mark-close {
    bottom: -0.05em;
    right: -0.1em;
  }

  .philosophy-quote {
    margin: 0;
    padding: 0 clamp(1.5rem, 5vw, 5rem);
    text-align: left;
  }

  .philosophy-quote p {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4.4vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }
  .phil-soft {
    font-weight: 400;
    color: var(--ink-2);
  }
  .phil-accent {
    color: var(--accent);
  }

  .philosophy-cite {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 0.25rem;
  }
  .cite-mark {
    color: var(--accent);
    width: 22px;
    height: 22px;
  }
  .cite-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .quote-mark { font-size: clamp(6rem, 16vw, 10rem); }
  }
</style>
