---
interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  slug: string;
  readTime?: string;
  featured?: boolean;
  index?: number;
}

const { title, description, date, category, slug, readTime, index = 0 } = Astro.props;

const d = new Date(date);
const formattedDate = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
const indexLabel = String(index + 1).padStart(2, '0');
---

<a href={`/blog/${slug}`} class="post-row row-invert" data-post-category={category.toLowerCase()}>
  <span class="post-row__index eyebrow">{indexLabel}</span>

  <span class="post-row__body">
    <span class="post-row__title">{title}</span>
    <span class="post-row__desc row-muted">{description}</span>
  </span>

  <span class="post-row__meta">
    <span class="post-row__cat eyebrow" style="color: var(--flare);">{category}</span>
    <span class="post-row__date eyebrow row-muted">{formattedDate}</span>
    {readTime && <span class="post-row__time eyebrow row-muted">{readTime}</span>}
  </span>
</a>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: start;
    gap: 1rem clamp(1rem, 2vw, 2rem);
    padding: clamp(1.25rem, 2.5vw, 1.875rem) clamp(0.75rem, 1.5vw, 1.25rem);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.15s var(--snap, cubic-bezier(.7,0,.2,1)),
                color 0.15s var(--snap, cubic-bezier(.7,0,.2,1));
  }

  .post-row__index {
    padding-top: 0.25rem;
    color: var(--muted);
    flex-shrink: 0;
  }

  .post-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .post-row__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 2.4vw, 1.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    transition: inherit;
  }

  .post-row__desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 64ch;
    transition: color 0.15s var(--snap, cubic-bezier(.7,0,.2,1));
  }

  .post-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    flex-shrink: 0;
    padding-top: 0.2rem;
    text-align: right;
  }

  .post-row__cat {
    color: var(--flare);
  }

  .post-row__date,
  .post-row__time {
    color: var(--muted);
  }

  /* row-invert hover — background becomes ink, text flips to paper */
  .post-row:hover {
    background-color: var(--ink);
    color: var(--paper);
    border-bottom-color: var(--ink);
  }

  .post-row:hover .post-row__index {
    color: var(--paper);
    opacity: 0.5;
  }

  .post-row:hover .post-row__cat {
    color: var(--flare);
  }

  .post-row:hover .post-row__desc,
  .post-row:hover .post-row__date,
  .post-row:hover .post-row__time {
    color: var(--paper);
    opacity: 0.65;
  }

  @media (max-width: 680px) {
    .post-row {
      grid-template-columns: 2rem 1fr;
      grid-template-rows: auto auto;
    }
    .post-row__meta {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      text-align: left;
      margin-top: 0.5rem;
    }
  }
</style>
