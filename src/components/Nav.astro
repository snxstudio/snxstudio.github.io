---
const links = [
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'Open Source', href: '/opensource' },
  { label: 'Journal', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="nav" id="site-nav">
  <div class="wrap nav__bar">
    <!-- Wordmark -->
    <a href="/" class="nav__brand" aria-label="SNX Studio — home">
      <span class="nav__mark">SNX</span>
      <span class="nav__mark-detail">/STUDIO</span>
    </a>

    <!-- Desktop links -->
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="nav__link link-underline"
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Right cluster -->
    <div class="nav__right">
      <span class="chip nav__chip">
        <span class="chip-dot"></span>
        Available — Q3
      </span>
      <button
        type="button"
        class="nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav__toggle-label" data-open="Menu" data-close="Close">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile fullscreen menu -->
  <div class="nav__menu" id="nav-menu" hidden>
    <nav class="wrap nav__menu-inner" aria-label="Mobile">
      <ol class="nav__menu-list">
        {links.map((l, i) => (
          <li>
            <a href={l.href} class="nav__menu-link" aria-current={isActive(l.href) ? 'page' : undefined}>
              <span class="nav__menu-index">{String(i + 1).padStart(2, '0')}</span>
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="chip nav__menu-chip">
        <span class="chip-dot"></span>
        Available — Q3
      </span>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.3s ease;
  }
  .nav.is-stuck { background: var(--paper); }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.25rem;
  }

  /* Wordmark */
  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    line-height: 1;
  }
  .nav__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .nav__mark-detail {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* Desktop links */
  .nav__links {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }
  .nav__link {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .nav__link[aria-current="page"] { color: var(--flare); }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav__chip { display: none; }

  /* Mobile toggle */
  .nav__toggle {
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    padding: 0.5rem 0.875rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.18s var(--snap), color 0.18s var(--snap);
  }
  .nav__toggle:hover,
  .nav__toggle[aria-expanded="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  /* Mobile menu panel */
  .nav__menu {
    position: fixed;
    inset: 4.25rem 0 0 0;
    background: var(--paper);
    z-index: 99;
    border-top: 1px solid var(--rule);
    overflow-y: auto;
  }
  .nav__menu[hidden] { display: none; }
  .nav__menu-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 2.5rem;
  }
  .nav__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .nav__menu-list li { border-top: 1px solid var(--rule); }
  .nav__menu-list li:last-child { border-bottom: 1px solid var(--rule); }
  .nav__menu-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 11vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
    transition: color 0.18s var(--snap);
  }
  .nav__menu-link:hover,
  .nav__menu-link[aria-current="page"] { color: var(--flare); }
  .nav__menu-index {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .nav__menu-chip { align-self: flex-start; }

  @media (min-width: 900px) {
    .nav__links { display: flex; }
    .nav__chip { display: inline-flex; }
    .nav__toggle { display: none; }
    .nav__menu { display: none !important; }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const label = toggle?.querySelector('.nav__toggle-label') as HTMLElement | null;

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    if (label) label.textContent = open ? label.dataset.close! : label.dataset.open!;
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // close on link click + Escape
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  // paper background once scrolled past the top hairline
  const onScroll = () => nav?.classList.toggle('is-stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
