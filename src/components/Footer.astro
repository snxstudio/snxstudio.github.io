---
const year = new Date().getFullYear();

const pages = [
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'Journal', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const openSource = [
  { label: 'Teamsly', href: '/opensource' },
  { label: 'mcp-elements', href: '/opensource' },
];

const elsewhere = [
  { label: 'GitHub', href: 'https://github.com/snxstudio' },
  { label: 'Email', href: 'mailto:hello@snxstudio.com' },
  { label: 'LinkedIn', href: '#' },
];
---

<footer class="footer">
  <hr class="rule" />

  <!-- Big editorial CTA -->
  <section class="wrap footer__cta">
    <p class="eyebrow">(→) — Start a conversation</p>
    <a href="/contact" class="footer__cta-link" aria-label="Contact SNX Studio">
      <span class="footer__cta-line">Let's build</span>
      <span class="footer__cta-line">something that <span class="flare">lasts.</span></span>
    </a>
  </section>

  <hr class="rule" />

  <!-- Link columns -->
  <section class="wrap footer__cols grid12">
    <div class="footer__brand">
      <span class="footer__mark">SNX</span>
      <p class="footer__blurb">
        A design and engineering studio working on AI, IoT, and web systems.
        Bengaluru, since 2024.
      </p>
      <span class="chip footer__chip">
        <span class="chip-dot"></span>
        Available — Q3
      </span>
    </div>

    <nav class="footer__col" aria-label="Pages">
      <p class="eyebrow">Pages</p>
      <ul>
        {pages.map((l) => (
          <li><a href={l.href} class="footer__link link-underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Open Source">
      <p class="eyebrow">Open Source</p>
      <ul>
        {openSource.map((l) => (
          <li><a href={l.href} class="footer__link link-underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Elsewhere">
      <p class="eyebrow">Elsewhere</p>
      <ul>
        {elsewhere.map((l) => (
          <li><a href={l.href} class="footer__link link-underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </section>

  <hr class="rule" />

  <!-- Colophon -->
  <section class="wrap footer__colophon">
    <span>SNX STUDIO — BENGALURU — EST. 2024</span>
    <span class="footer__clock" id="footer-clock">IST — {year}</span>
  </section>
</footer>

<style>
  .footer { background: var(--paper); }

  /* CTA */
  .footer__cta { padding-block: clamp(3rem, 8vw, 6rem); }
  .footer__cta .eyebrow { margin-bottom: 1.5rem; }
  .footer__cta-link {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 11vw, 8rem);
    letter-spacing: -0.03em;
    line-height: 0.92;
    color: var(--ink);
    transition: color 0.18s var(--snap);
  }
  .footer__cta-line { display: block; }
  .footer__cta-link:hover { color: var(--ink-2); }
  .footer__cta-link:hover .flare { color: var(--flare); }

  /* Columns */
  .footer__cols { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .footer__brand { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1rem; }
  .footer__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .footer__blurb { max-width: 38ch; color: var(--ink-2); font-size: 0.95rem; line-height: 1.5; }
  .footer__chip { align-self: flex-start; }

  .footer__col ul { list-style: none; margin: 0.875rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.625rem; }
  .footer__link {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .footer__col { grid-column: span 4; }

  /* Colophon */
  .footer__colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding-block: 1.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .footer__brand { grid-column: span 6; }
    .footer__col { grid-column: span 2; }
  }
</style>

<script>
  // live-ish local time in IST
  const el = document.getElementById('footer-clock');
  if (el) {
    const tick = () => {
      const t = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'Asia/Kolkata',
      }).format(new Date());
      el.textContent = `${t} IST — ${new Date().getFullYear()}`;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
