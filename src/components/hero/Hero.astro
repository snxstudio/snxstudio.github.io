---
// Hero — tankr.design-inspired: black canvas, dotted grid, full-bleed
// wordmark, edge-justified caption rule. Electric-blue is the only accent.
const capabilities = [
  'AI Native',
  'Industrial IoT',
  'Web Platforms',
  'Design Systems',
  'Cloud / DevEx',
  'Technical Advisory',
];
---

<section class="hero" id="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Top meta row -->
    <div class="hero-top animate-fade-in delay-100">
      <span class="hero-top-mark">SNX&#8201;°&#8201;STUDIO</span>
      <span class="hero-top-tag">AI-native technology &amp; design</span>
      <span class="hero-top-coords">12.97°N&#8201;·&#8201;77.59°E</span>
    </div>

    <!-- Full-bleed wordmark -->
    <h1 class="hero-word animate-fade-in-up delay-200">
      SNX<span class="hero-word-dot">.</span>
    </h1>

    <!-- Signature caption rule -->
    <div class="hero-caption animate-fade-in delay-300">
      <span class="hero-caption-l">We design, build &amp; ship intelligent systems</span>
      <span class="hero-caption-rule" aria-hidden="true"></span>
      <span class="hero-caption-r">with intent</span>
    </div>

    <!-- Lede + actions -->
    <div class="hero-belt animate-fade-in-up delay-400">
      <p class="hero-lede">
        A multi-product studio — <em>SaaS, open-source, and commissioned
        work</em> — built around senior engineering and opinionated design,
        with AI woven through the craft, not bolted on top.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Start a conversation</a>
        <a href="/work" class="btn-ghost">See the work</a>
      </div>
    </div>
  </div>

  <!-- Bottom capability rail -->
  <ul class="hero-rail" role="list">
    {capabilities.map(cap => (
      <li class="hero-rail-item">{cap}</li>
    ))}
  </ul>
</section>

<style>
  /* Hero forces a black canvas regardless of theme, tankr-style */
  .hero {
    --hero-bg: #050506;
    --hero-ink: #F4F5F7;
    --hero-ink-2: #9097A0;
    --hero-line: rgba(255, 255, 255, 0.14);
    --hero-dot: rgba(255, 255, 255, 0.07);
    --hero-accent: #5B86FF;

    position: relative;
    overflow-x: clip;
    background: var(--hero-bg);
    color: var(--hero-ink);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: clamp(5.5rem, 12vh, 8rem);
  }

  /* Dotted grid texture */
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--hero-dot) 1.4px, transparent 1.4px);
    background-size: 24px 24px;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 88%, transparent);
            mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 88%, transparent);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  /* ── Top meta row ── */
  .hero-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hero-ink-2);
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
  }
  .hero-top-mark { color: var(--hero-ink); }
  .hero-top-tag { flex: 1; }
  .hero-top-coords { color: var(--hero-ink-2); }

  /* ── Full-bleed wordmark ── */
  .hero-word {
    margin: 0;
    /* take container width, never expand ancestors — overflowing glyphs
       are clipped symmetrically so the wordmark bleeds off both edges */
    width: 100%;
    min-width: 0;
    overflow: clip;
    font-family: var(--font-wordmark);
    font-weight: 800;
    font-size: clamp(7rem, 36vw, 28rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--hero-ink);
    text-align: center;
    white-space: nowrap;
  }
  .hero-word-dot { color: var(--hero-accent); }

  /* ── Caption rule ── */
  .hero-caption {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vh, 2rem);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.85rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hero-ink-2);
  }
  .hero-caption-l { color: var(--hero-ink); }
  .hero-caption-rule {
    flex: 1;
    height: 1px;
    background: var(--hero-line);
  }
  .hero-caption-r { white-space: nowrap; }

  /* ── Lede + actions ── */
  .hero-belt {
    margin-top: auto;
    padding-top: clamp(2.5rem, 6vh, 4rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
  }
  .hero-lede {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--hero-ink-2);
    max-width: 56ch;
  }
  .hero-lede em {
    font-style: normal;
    font-weight: 600;
    color: var(--hero-ink);
  }
  .hero-actions {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    justify-self: end;
  }
  /* Local button skins (the global ones assume light bg) */
  .hero .btn-primary {
    background: var(--hero-accent);
    color: #050506;
    border: 1px solid var(--hero-accent);
    padding: 0.7rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
    transition: opacity 0.2s var(--ease, ease);
  }
  .hero .btn-primary:hover { opacity: 0.85; }
  .hero .btn-ghost {
    background: transparent;
    color: var(--hero-ink);
    border: 1px solid var(--hero-line);
    padding: 0.7rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .hero .btn-ghost:hover { border-color: var(--hero-ink); }

  /* ── Bottom rail ── */
  .hero-rail {
    position: relative;
    z-index: 2;
    list-style: none;
    margin: 0;
    padding: 0.9rem clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--hero-line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.25rem;
  }
  .hero-rail-item {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hero-ink-2);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .hero-rail-item::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--hero-accent);
    flex-shrink: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero { min-height: auto; padding-bottom: 0; }
    .hero-top { flex-wrap: wrap; gap: 0.5rem 1rem; }
    .hero-top-tag { flex-basis: 100%; order: 3; }
    .hero-top-coords { display: none; }
    .hero-word { font-size: clamp(4.5rem, 42vw, 12rem); }
    .hero-caption { flex-wrap: wrap; gap: 0.5rem; }
    .hero-caption-rule { flex-basis: 100%; }
    .hero-belt { grid-template-columns: 1fr; align-items: start; }
    .hero-actions { justify-self: start; }
  }
</style>
