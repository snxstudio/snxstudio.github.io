---
const routes = [
  { href: '/',             label: '/' },
  { href: '/work',         label: '/work' },
  { href: '/blog',         label: '/log' },
  { href: '/services',     label: '/capabilities' },
  { href: '/contact',      label: '/availability' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sb">
  <div class="sb-row sb-row-top">
    <a href="/" class="sb-brand">SNX/STUDIO</a>
    <span class="sb-sep" aria-hidden="true">·</span>
    <span class="sb-loc">bangalore · 12.97°N 77.59°E</span>
    <span class="sb-spacer"></span>
    <span class="sb-clock" data-noc-clock>--:--:-- IST</span>
  </div>
  <div class="sb-row sb-row-nav">
    <nav class="sb-nav" aria-label="Primary">
      {routes.map(r => (
        <a
          href={r.href}
          class={`sb-link${isActive(r.href) ? ' is-active' : ''}`}
        >{r.label}</a>
      ))}
    </nav>
    <span class="sb-spacer"></span>
    <span
      class="sb-status"
      title="We have space for one new project starting July 2026. Click for details."
    >
      <a href="/contact" class="sb-status-link">
        <span class="noc-dot ok live" aria-hidden="true"></span>
        ACCEPTING 1 ENGAGEMENT / Q3 2026
      </a>
    </span>
  </div>
</header>

<script>
  function tickClock() {
    const els = document.querySelectorAll<HTMLElement>('[data-noc-clock]');
    if (!els.length) return;
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kolkata',
      hour12: false,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
    const txt = `${fmt.format(new Date())} IST`;
    els.forEach(el => { el.textContent = txt; });
  }
  tickClock();
  setInterval(tickClock, 1000);
</script>

<style>
  .sb {
    border-bottom: 1px solid var(--ink);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .sb-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    font-size: 11px;
    letter-spacing: 0.03em;
  }
  .sb-row + .sb-row {
    border-top: 1px solid var(--rule);
  }

  .sb-brand {
    font-weight: 700;
    letter-spacing: 0;
    color: var(--ink);
  }
  .sb-sep   { color: var(--ink-3); }
  .sb-loc {
    color: var(--ink-2);
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .sb-spacer { flex: 1; }
  .sb-clock {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  .sb-nav {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
  }
  .sb-link {
    padding: 5px 10px;
    color: var(--ink-2);
    font-size: 11px;
    letter-spacing: 0;
    border: 1px solid var(--rule);
    border-left: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .sb-link:first-child { border-left: 1px solid var(--rule); }
  .sb-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .sb-link.is-active {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--bg-panel-2);
  }

  .sb-status {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: help;
  }
  .sb-status-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid var(--ink);
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .sb-status-link:hover {
    border-color: var(--ink);
    background: var(--bg-panel-2);
  }

  @media (max-width: 720px) {
    .sb-row { gap: 8px; padding: 8px 16px; flex-wrap: wrap; }
    .sb-loc, .sb-sep { display: none; }
  }
</style>
