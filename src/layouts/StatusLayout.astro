---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'SNX/STUDIO is an engineering agency in Bangalore routing unclear industrial, AI, logistics, and public-sector problems into shipped software.'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://snxstudio.com');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="/fonts/Syne-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
  />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="canonical" href={canonicalURL} />

  <title>{title}</title>
</head>
<body class="noc">
  <slot />
</body>
</html>

<style is:global>
  @font-face {
    font-family: 'Syne';
    src: url('/fonts/Syne-Bold.woff2') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --bg:           #F1F2EE;
    --bg-panel:     #FFFFFF;
    --bg-panel-2:   #E6E8E1;
    --ink:          #0B0C0E;
    --ink-2:        #5A5E66;
    --ink-3:        #8A8F99;
    --rule:         #D7DAD2;
    --rule-strong:  #0B0C0E;
    --signal-ok:    #1FA45C;
    --signal-watch: #D4A017;
    --signal-alert: #C13B2F;
    --signal-idle:  #5A5E66;
    --signal-stale: #B9BEC6;
    --route-blue:   #2457FF;
    --route-green:  #15A36B;
    --route-red:    #E03D2D;
    --route-amber:  #F0B429;
    --route-label:  #FFFFFF;
    --font-mono:  'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-display: 'Syne', 'Arial Black', Impact, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body.noc {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(11, 12, 14, 0.08) 0 1px, transparent 1px 100%) 0 0 / 17px 100%,
      linear-gradient(180deg, rgba(11, 12, 14, 0.06) 0 1px, transparent 1px 100%) 0 0 / 100% 29px,
      var(--bg);
    overflow-x: hidden;
  }

  body.noc .mono,
  body.noc [data-mono] {
    font-family: var(--font-mono);
    font-feature-settings: "tnum" on, "lnum" on;
  }

  body.noc a {
    color: inherit;
    text-decoration: none;
  }

  body.noc h1,
  body.noc h2,
  body.noc h3,
  body.noc h4 {
    margin: 0;
    font-weight: 600;
    line-height: 1.1;
  }

  body.noc ::selection {
    background: var(--ink);
    color: var(--bg);
  }

  body.noc :focus-visible {
    outline: 2px solid var(--signal-watch);
    outline-offset: 2px;
  }

  /* Shared operating-surface primitives */
  .noc-frame {
    border: 1px solid var(--ink);
    background: var(--bg-panel);
  }

  .noc-shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px;
  }

  .noc-numeral {
    font-family: var(--font-display);
    font-weight: 800;
    font-feature-settings: "tnum" on, "lnum" on;
    letter-spacing: 0;
    line-height: 0.9;
    color: var(--ink);
  }

  .noc-link {
    color: var(--ink);
    border-bottom: 1px solid currentColor;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .noc-link:hover {
    color: var(--signal-ok);
  }

  .noc-eyebrow {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-weight: 500;
  }

  .noc-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-idle);
    flex-shrink: 0;
    vertical-align: middle;
  }
  .noc-dot.ok     { background: var(--signal-ok); }
  .noc-dot.watch  { background: var(--signal-watch); }
  .noc-dot.alert  { background: var(--signal-alert); }
  .noc-dot.idle   { background: var(--signal-idle); }
  .noc-dot.stale  { background: var(--signal-stale); }

  .noc-dot.live {
    box-shadow: 0 0 0 0 rgba(90, 94, 102, 0.35);
    animation: nocPulse 2.4s steps(5, end) infinite;
  }
  .noc-dot.ok.live {
    box-shadow: 0 0 0 0 rgba(31, 164, 92, 0.45);
    animation-name: nocPulseGreen;
  }
  @keyframes nocPulse {
    0%   { box-shadow: 0 0 0 0 rgba(90, 94, 102, 0.35); }
    70%  { box-shadow: 0 0 0 10px rgba(90, 94, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(90, 94, 102, 0); }
  }
  @keyframes nocPulseGreen {
    0%   { box-shadow: 0 0 0 0 rgba(31, 164, 92, 0.45); }
    70%  { box-shadow: 0 0 0 10px rgba(31, 164, 92, 0); }
    100% { box-shadow: 0 0 0 0 rgba(31, 164, 92, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .noc-dot.live { animation: none; }
  }
</style>
