---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  publishedTime?: string;
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const DEFAULT_KEYWORDS = 'SNX Studio, AI studio, AI-native development, technology studio India, software studio Bengaluru, IoT development, design systems, SaaS development, technical advisory';

const {
  title,
  description = 'AI-native technology & design studio. We design, build, and ship intelligent systems — SaaS, open-source, and commissioned work.',
  keywords = DEFAULT_KEYWORDS,
  ogType = 'website',
  publishedTime,
  extraSchema,
  noindex = false,
} = Astro.props;

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const SITE = Astro.site || 'https://wearesnx.studio';
const canonicalURL = new URL(Astro.url.pathname, SITE);
const ogImage = new URL('/og-image.png', SITE);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${SITE}#organization`,
    name: 'SNX Studio',
    url: SITE.toString(),
    logo: new URL('/favicon.svg', SITE).toString(),
    description: 'AI-native technology & design studio building SaaS, open-source, and commissioned work.',
    sameAs: [
      'https://github.com/mayurrawte',
      'https://in.linkedin.com/in/mayurrawte',
      'https://medium.com/@rawte.mayur',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE}#website`,
    url: SITE.toString(),
    name: 'SNX Studio',
    publisher: { '@id': `${SITE}#organization` },
  },
];
if (extraSchema) graph.push(...(Array.isArray(extraSchema) ? extraSchema : [extraSchema]));

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="SNX Studio" />
  <meta name="robots" content={robotsContent} />
  <meta name="theme-color" content="#050506" />
  <meta name="generator" content={Astro.generator} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Preload fonts -->
  <link rel="preload" href="/fonts/Syne-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Editorial italic + monospace from Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- OG Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="SNX Studio" />
  <meta property="og:site_name" content="SNX Studio" />
  <meta property="og:locale" content="en_US" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="SNX Studio" />

  <link rel="canonical" href={canonicalURL} />

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- No-JS fallback: scroll-reveal elements default to hidden; make them
       visible (and skip the transform) when JavaScript is unavailable so
       no content — including the contact form — is ever stranded. -->
  <noscript>
    <style>
      .reveal { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <title>{title}</title>
</head>
<body>
  <slot />

  <!-- Scroll reveal observer -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</body>
</html>
