---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  readTime?: string;
}

const { title, description, date, category, readTime } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${title} — SNX Studio`} description={description}>
  <main>
    <article class="post">
      <!-- Post header -->
      <header class="post-header">
        <div class="wrap post-header-inner">
          <div class="post-header__eyebrow">
            <span class="eyebrow reveal" style="color: var(--flare);">{category}</span>
            <span class="eyebrow reveal reveal-d1" style="color: var(--muted);">{formattedDate}</span>
            {readTime && <span class="eyebrow reveal reveal-d1" style="color: var(--muted);">{readTime}</span>}
          </div>
          <h1 class="post-title reveal reveal-d1">{title}</h1>
          <p class="post-description reveal reveal-d2">{description}</p>
        </div>
      </header>

      <hr class="rule" />

      <!-- Body -->
      <div class="post-content">
        <div class="wrap">
          <div class="post-grid">
            <!-- Sidebar / meta -->
            <aside class="post-sidebar reveal">
              <div class="sidebar-meta">
                <div class="sidebar-item">
                  <span class="eyebrow" style="color: var(--muted);">CATEGORY</span>
                  <span class="mono" style="color: var(--flare); margin-top: 0.25rem; display: block;">{category}</span>
                </div>
                <div class="sidebar-item">
                  <span class="eyebrow" style="color: var(--muted);">PUBLISHED</span>
                  <span class="mono" style="color: var(--ink-2); margin-top: 0.25rem; display: block;">{formattedDate}</span>
                </div>
                {readTime && (
                  <div class="sidebar-item">
                    <span class="eyebrow" style="color: var(--muted);">READ TIME</span>
                    <span class="mono" style="color: var(--ink-2); margin-top: 0.25rem; display: block;">{readTime}</span>
                  </div>
                )}
                <div class="sidebar-rule" aria-hidden="true"></div>
                <a href="/blog" class="sidebar-back">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
                    <line x1="17" y1="12" x2="7" y2="12"/>
                    <polyline points="11,7 7,12 11,17"/>
                  </svg>
                  <span class="eyebrow">ALL PIECES</span>
                </a>
              </div>
            </aside>

            <!-- Prose column -->
            <div class="prose reveal reveal-d1">
              <slot />
            </div>
          </div>
        </div>
      </div>

      <hr class="rule" />

      <!-- Post footer -->
      <footer class="post-footer">
        <div class="wrap post-footer-inner">
          <a href="/blog" class="footer-back">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
              <line x1="17" y1="12" x2="7" y2="12"/>
              <polyline points="11,7 7,12 11,17"/>
            </svg>
            <span class="eyebrow">BACK TO JOURNAL</span>
          </a>
          <a href="/contact" class="footer-cta btn btn-flare">
            Commission a teardown
          </a>
        </div>
      </footer>
    </article>
  </main>
</Layout>

<style is:global>
  /* ---- Prose styles ---- */
  .prose {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.72;
    color: var(--ink-2);
    max-width: 68ch;
  }

  .prose h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    color: var(--ink);
    margin: 3.5rem 0 1rem;
    line-height: 1.05;
    letter-spacing: -0.03em;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .prose h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--ink);
    margin: 2.5rem 0 0.75rem;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .prose h4 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2rem 0 0.5rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: var(--ink-2);
  }

  .prose strong {
    font-weight: 600;
    color: var(--ink);
  }

  .prose em {
    font-style: italic;
    color: var(--ink);
  }

  .prose a {
    color: var(--flare);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-thickness 0.15s;
  }
  .prose a:hover { text-decoration-thickness: 2px; }

  .prose ul {
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    list-style: none;
  }
  .prose ul > li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--ink-2);
  }
  .prose ul > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 5px;
    height: 5px;
    background: var(--flare);
    flex-shrink: 0;
  }

  .prose ol {
    counter-reset: prose-ol;
    list-style: none;
    margin: 0 0 1.5rem;
    padding-left: 0;
  }
  .prose ol > li {
    counter-increment: prose-ol;
    padding-left: 2.5rem;
    position: relative;
    margin-bottom: 0.6rem;
    color: var(--ink-2);
  }
  .prose ol > li::before {
    content: counter(prose-ol, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--flare);
    font-weight: 500;
    line-height: 1.72;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.84em;
    background-color: var(--paper-2);
    padding: 0.12em 0.4em;
    color: var(--ink);
    border: 1px solid var(--rule);
  }

  .prose pre {
    background-color: var(--ink);
    color: var(--paper);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
  }
  .prose pre code {
    background: none;
    padding: 0;
    border: none;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--paper);
  }

  .prose blockquote {
    border-left: 3px solid var(--flare);
    padding: 0.5rem 0 0.5rem 1.75rem;
    margin: 2.5rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.025em;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 3rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .prose th {
    border-bottom: 2px solid var(--ink);
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: var(--ink);
  }
  .prose td {
    border-bottom: 1px solid var(--rule);
    padding: 0.625rem 0.75rem;
    color: var(--ink-2);
    vertical-align: top;
  }
</style>

<style>
  /* ---- Post page layout ---- */
  .post-header {
    padding-top: calc(78px + clamp(3rem, 6vw, 5rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .post-header-inner {
    max-width: 1320px;
  }

  .post-header__eyebrow {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 7vw, 5.5rem);
    line-height: 0.93;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin-bottom: 1.5rem;
    max-width: 22ch;
  }

  .post-description {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 60ch;
  }

  /* Content grid: sidebar + prose */
  .post-content {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  /* Sidebar */
  .post-sidebar {
    position: sticky;
    top: calc(78px + 2rem);
  }

  .sidebar-meta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-item {
    display: flex;
    flex-direction: column;
  }

  .sidebar-rule {
    height: 1px;
    background: var(--rule);
    margin: 0.25rem 0;
  }

  .sidebar-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .sidebar-back:hover {
    color: var(--flare);
  }
  .sidebar-back svg {
    transition: transform 0.2s;
  }
  .sidebar-back:hover svg {
    transform: translateX(-3px);
  }

  /* Post footer */
  .post-footer {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }
  .post-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-back:hover {
    color: var(--flare);
  }
  .footer-back svg {
    transition: transform 0.2s;
  }
  .footer-back:hover svg {
    transform: translateX(-3px);
  }

  @media (max-width: 860px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
    .post-sidebar {
      position: static;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 1.5rem;
      margin-bottom: 0.5rem;
    }
    .sidebar-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .sidebar-rule {
      display: none;
    }
  }
</style>
