---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const cases = [
  {
    idx: '01',
    title: 'Maritime Routing Engine',
    sector: 'Open Source · Geospatial · TypeScript',
    year: '2022 — Now',
    role: 'Author &amp; maintainer',
    challenge: 'Sea-route libraries were either commercial, unmaintained, or quietly wrong around the places that matter most — canals and chokepoints. Logistics teams kept rebuilding the same flawed shortest-path over the same bad graph.',
    approach: 'Open-source it properly. searoute-ts ships the 2025 Eurostat maritime network, canal and strait restrictions (Suez, Panama, Bab-el-Mandeb), vessel-draft gating, K-shortest alternatives, multi-leg waypoints, and ETA from speed — behind a stable, MIT-licensed npm API.',
    result: 'Now downloaded roughly 13,000 times a month and actively maintained. It is the open-source backbone of everything else we do in logistics.',
    metrics: [
      { value: '13.4k', label: 'npm downloads / month' },
      { value: 'MIT', label: 'Free, forever' },
      { value: '2022', label: 'Maintained since' },
    ],
    stack: ['TypeScript', 'GeoJSON', 'Eurostat network', 'npm', 'GitHub Actions'],
    external: 'https://github.com/mayurrawte/searoute-ts',
  },
  {
    idx: '02',
    title: 'Teamsly — Teams, Rebuilt',
    sector: 'Product · MCP · Microsoft Graph',
    year: '2026 — Now',
    role: 'Author &amp; maintainer',
    challenge: 'Microsoft Teams is unavoidable in enterprise and unloved by the people who live in it all day. Slow, mouse-bound, and completely closed to the AI tooling everyone now works alongside.',
    approach: 'A keyboard-first client built directly on the Graph API — AI thread summaries, voice rooms, themes, disappearing DMs — plus an MCP server so Claude and Cursor can read and send Teams messages as first-class tools.',
    result: 'Open-source and self-hostable, distributed through a Homebrew tap. One of the first Teams clients to expose itself over MCP.',
    metrics: [
      { value: 'MCP', label: 'Native Claude &amp; Cursor tools' },
      { value: 'Graph', label: 'Direct Microsoft API' },
      { value: 'OSS', label: 'Self-hostable' },
    ],
    stack: ['TypeScript', 'Next.js', 'Electron', 'Microsoft Graph', 'MCP'],
    external: 'https://teamsly.app/',
  },
  {
    idx: '03',
    title: 'Lit Pigeon — Email, Unlocked',
    sector: 'Developer Platform · Web Components',
    year: '2026 — Now',
    role: 'Author &amp; maintainer',
    challenge: 'Every email editor on the market is either locked inside someone\'s SaaS or welded to one frontend framework. Teams end up rebuilding the same drag-and-drop composer for the third time, in a fourth framework.',
    approach: 'Build the editor once as framework-agnostic web components, then ship thin wrappers for React, Vue, Angular and Svelte over a shared core — with MJML parsing and rendering, SSR, a REST adapter, pre-flight linting, Figma import, and an MCP server for authoring emails from an AI client.',
    result: 'Fourteen MIT-licensed packages on npm covering the full pipeline from Figma frame to rendered, spam-checked HTML.',
    metrics: [
      { value: '14', label: 'npm packages, MIT' },
      { value: '5', label: 'Frameworks supported' },
      { value: 'MJML', label: 'Parse, render, lint' },
    ],
    stack: ['TypeScript', 'Lit', 'MJML', 'React / Vue / Angular / Svelte', 'MCP'],
    external: 'https://github.com/snxstudio/lit-pigeon',
  },
  {
    idx: '04',
    title: 'mcp-elements — UI for AI Apps',
    sector: 'Design System · MCP · Multi-framework',
    year: '2026 — Now',
    role: 'Author &amp; maintainer',
    challenge: 'Every team building on MCP reinvents the same interface problems from zero: how do you render a tool call, ask for OAuth consent, show a scope inspector, or generate a form from a JSON Schema — without it looking like a debug view?',
    approach: 'A copy-paste component library in the shadcn tradition — the CLI writes source into your project rather than adding a dependency. Framework-agnostic state machines in the core, with React, Vue and Angular implementations over a shared Tailwind v4 OKLCH token layer.',
    result: 'Thirty-eight components across three frameworks, including MCP-native primitives no other library ships.',
    metrics: [
      { value: '38', label: 'Components' },
      { value: '3', label: 'Frameworks, one core' },
      { value: 'MIT', label: 'Copy-paste, no lock-in' },
    ],
    stack: ['TypeScript', 'React', 'Vue', 'Angular', 'Tailwind v4', 'MCP'],
    external: 'https://github.com/mcp-elements/ui',
  },
  {
    idx: '05',
    title: 'ELIOT — Smart Energy Telemetry',
    sector: 'Industrial IoT · Embedded · Research',
    year: '2017 — 2019',
    role: 'Lead engineer &amp; co-author',
    challenge: 'Distribution grids in tier-2 Indian cities had almost no real-time visibility into consumption or load, and wholesale meter replacement was neither politically nor economically possible.',
    approach: 'A drop-in device that reads an existing analogue meter by counting its kWh pulse LED, reports hourly usage over MQTT, and gates supply on a prepaid balance — recharged through a web portal, with a 24-hour grace period at zero.',
    result: 'Published in the International Journal of Computer Applications (August 2017). Second Runner-up at Smart India Hackathon 2018, where it was recognised by India\'s Ministry of Power &amp; Coal as a best electricity-monitoring solution.',
    metrics: [
      { value: 'IJCA', label: 'Peer-reviewed, Aug 2017' },
      { value: 'MoP', label: 'Ministry recognition' },
      { value: 'SIH', label: '2nd Runner-up, 2018' },
    ],
    stack: ['Embedded C', 'NodeMCU / ESP8266', 'Lua', 'MQTT', 'TypeScript'],
    external: 'https://github.com/mayurrawte/EliotV27',
  },
  {
    idx: '06',
    title: 'Developer Tooling',
    sector: 'Open Source · Developer Experience',
    year: '2019 — Now',
    role: 'Author &amp; maintainer',
    challenge: 'The same small frictions cost engineering teams real hours: PR review queues that rot, HTTP failures you cannot reproduce, CI that rebuilds everything on every push.',
    approach: 'A set of narrow tools, each built because we hit the problem first. SherlockQA reviews pull requests with AI and leaves inline comments. httpx-debug turns any failing Python request into a paste-able, secret-redacted curl. Angular Setup and Nx Affected cut monorepo CI down to what actually changed.',
    result: 'All MIT-licensed and published — on the GitHub Marketplace, npm, and PyPI.',
    metrics: [
      { value: 'MIT', label: 'Every tool, open' },
      { value: '3', label: 'Registries published to' },
      { value: 'Own itch', label: 'Every one of them' },
    ],
    stack: ['TypeScript', 'Python', 'GitHub Actions', 'Nx', 'Anthropic SDK'],
    external: 'https://github.com/mayurrawte',
  },
];

const oss = [
  {
    name: 'mcp-elements/ui',
    desc: 'Copy-paste UI components for AI apps — 38 across React, Vue & Angular, including MCP-native primitives. MIT.',
    lang: 'TypeScript',
    url: 'https://github.com/mcp-elements/ui',
  },
  {
    name: 'teamsly',
    desc: 'Keyboard-first Microsoft Teams client with AI summaries and an MCP server for Claude. Self-hostable, AGPL-3.0.',
    lang: 'TypeScript',
    url: 'https://teamsly.app/',
  },
  {
    name: 'lit-pigeon',
    desc: 'Drag & drop email editor as web components. Exports clean MJML and HTML. MIT.',
    lang: 'TypeScript',
    url: 'https://lit-pigeon.wearesnx.studio/',
  },
];
---

<Layout title="Work — SNX Studio" description="Things we built and still run: searoute-ts maritime routing, Teamsly, Lit Pigeon, mcp-elements, and the ELIOT smart energy meter." keywords="SNX Studio work, searoute-ts, maritime routing, Teamsly, MCP, Model Context Protocol, Lit Pigeon, email editor, mcp-elements, smart energy IoT, open source, portfolio">
  <Nav />
  <main>
    <!-- Hero -->
    <section class="page-hero">
      <div class="container-wide">
        <span class="label label-mark animate-fade-in-up">Selected work</span>
        <h1 class="page-h1 animate-fade-in-up delay-200">
          Things that<br/>
          <span class="accent">actually</span> shipped.
        </h1>
        <p class="lede animate-fade-in-up delay-400" style="max-width: 660px; margin-top: 1.5rem;">
          A working studio doesn't get the luxury of vapourware. Everything below is public —
          the repository, the licence, the download count. Click any of it and check.
        </p>
      </div>
    </section>

    <!-- Cases -->
    <section class="cases-section">
      <div class="container-wide">
        {cases.map((c) => (
          <article class="case reveal">
            <header class="case-head">
              <span class="case-idx numeral">{c.idx}</span>
              <div class="case-head-meta">
                <span class="case-sector">{c.sector}</span>
                <span class="case-year">{c.year}</span>
                <span class="case-role" set:html={c.role}></span>
              </div>
            </header>

            <h2 class="case-title">
              {c.title}
              {c.external && (
                <a href={c.external} target="_blank" rel="noopener noreferrer" class="case-ext" aria-label="Open repository">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7,7 17,7 17,17"/>
                  </svg>
                </a>
              )}
            </h2>

            <div class="case-body">
              <div class="case-narrative">
                <div class="case-section">
                  <h4 class="case-label">Challenge</h4>
                  <p set:html={c.challenge}></p>
                </div>
                <div class="case-section">
                  <h4 class="case-label">Approach</h4>
                  <p set:html={c.approach}></p>
                </div>
                <div class="case-section">
                  <h4 class="case-label">Result</h4>
                  <p set:html={c.result}></p>
                </div>
              </div>

              <aside class="case-aside">
                <ul class="case-metrics" role="list">
                  {c.metrics.map(m => (
                    <li>
                      <span class="case-metric-val numeral">{m.value}</span>
                      <span class="case-metric-label">{m.label}</span>
                    </li>
                  ))}
                </ul>

                <ul class="case-stack" role="list">
                  {c.stack.map(s => <li>{s}</li>)}
                </ul>
              </aside>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Open Source -->
    <section class="section bg-surface-alt">
      <div class="container-wide">
        <header class="oss-header">
          <span class="label label-mark">Open source</span>
          <h2 class="oss-h2">
            Tools we keep <span class="accent">in the open.</span>
          </h2>
        </header>

        <div class="oss-grid">
          {oss.map(o => (
            <a href={o.url} target="_blank" rel="noopener noreferrer" class="oss-card reveal">
              <h3 class="oss-name">{o.name}</h3>
              <p class="oss-desc">{o.desc}</p>
              <div class="oss-meta">
                <span class="oss-lang">{o.lang}</span>
                <span class="oss-arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          ))}
        </div>

        <a href="/opensource" class="oss-link">
          See the full open-source archive
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7,7 17,7 17,17"/>
          </svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    padding-top: calc(78px + clamp(4rem, 8vw, 7rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .page-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    margin-top: 1.5rem;
  }
  .page-h1 .accent { color: var(--accent); }

  .cases-section { padding: 0 0 clamp(4rem, 8vw, 7rem); border-top: 1px solid var(--ink); }

  .case {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-bottom: 1px solid var(--border);
  }
  .case-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .case-idx {
    font-size: 1rem;
    color: var(--accent);
  }
  .case-head-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-role {
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .case-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin-bottom: 2rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .case-ext { color: var(--muted); transition: color 0.3s ease, transform 0.3s ease; }
  .case-ext:hover { color: var(--accent); transform: translate(4px, -4px); }

  .case-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .case-narrative {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .case-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .case-section p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .case-aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.75rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .case-metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .case-metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .case-metrics li:last-child { border-bottom: none; padding-bottom: 0; }
  .case-metric-val {
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
  }
  .case-metric-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .case-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .case-stack li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
  }

  /* OSS preview */
  .oss-header { display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .oss-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .oss-h2 .accent { color: var(--accent); }
  .oss-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .oss-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--ink);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .oss-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .oss-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.025em;
  }
  .oss-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-2);
    flex: 1;
  }
  .oss-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .oss-arrow { color: var(--accent); font-size: 1rem; }
  .oss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .oss-link svg { transition: transform 0.3s ease; }
  .oss-link:hover svg { transform: translate(3px, -3px); }

  @media (max-width: 880px) {
    .case-body { grid-template-columns: 1fr; }
    .oss-grid { grid-template-columns: 1fr; }
  }
</style>
