---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featured = posts.find(p => p.data.featured) ?? posts[0];
const rest = posts.filter(p => p !== featured);

const categories = ['All', 'Teardown', 'AI', 'Engineering', 'IoT', 'Design'];
---

<Layout title="Journal — SNX Studio" description="Teardowns, theses, and field notes from a working design and engineering studio in Bengaluru.">
  <main>
    <!-- Hero -->
    <section class="section" style="padding-top: calc(78px + clamp(3rem, 7vw, 6rem)); padding-bottom: 0;">
      <div class="wrap">
        <div class="grid12 hero-grid">
          <div class="hero-copy">
            <span class="eyebrow reveal">(05) — JOURNAL</span>
            <h1 class="display reveal reveal-d1">
              Teardowns,<br/>theses,<br/><span class="flare">& opinions</span><br/>you didn't ask for.
            </h1>
          </div>
          <div class="hero-aside reveal reveal-d2">
            <p class="hero-lede">
              Long-form writing on the systems we admire, the ones we'd redesign, and the ones we wish someone
              would take a saw to. Slow-published, often uncomfortable.
            </p>
            <p class="hero-stat">
              <span class="numeral" style="font-size: clamp(2.5rem,5vw,4rem);">{posts.length}</span>
              <span class="mono" style="display:block; margin-top: 0.25rem; color: var(--muted);">PUBLISHED PIECES</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- Filter bar -->
    <div class="filter-bar">
      <div class="wrap">
        <div class="filter-inner">
          {categories.map((cat, i) => (
            <button
              class:list={['filter-btn', { active: cat === 'All' }]}
              data-category={cat.toLowerCase()}
            >
              <span class="filter-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{cat}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <hr class="rule" />

    <!-- Featured post -->
    {featured && (
      <section class="section-sm featured-section">
        <div class="wrap">
          <span class="eyebrow reveal" style="display:block; margin-bottom: 1.5rem;">FEATURED PIECE</span>
          <a href={`/blog/${featured.id}`} class="featured-row reveal reveal-d1" data-post-category={featured.data.category.toLowerCase()}>
            <div class="featured-row__body">
              <div class="featured-row__meta">
                <span class="eyebrow" style="color: var(--flare);">{featured.data.category}</span>
                <span class="eyebrow" style="color: var(--muted);">
                  {new Date(featured.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' })}
                </span>
                {featured.data.readTime && <span class="eyebrow" style="color: var(--muted);">{featured.data.readTime}</span>}
              </div>
              <h2 class="featured-row__title">{featured.data.title}</h2>
              <p class="featured-row__desc">{featured.data.description}</p>
            </div>
            <span class="featured-row__cta">
              <span class="eyebrow">READ</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
                <line x1="7" y1="17" x2="17" y2="7"/>
                <polyline points="7,7 17,7 17,17"/>
              </svg>
            </span>
          </a>
        </div>
      </section>
    )}

    <hr class="rule" />

    <!-- All posts list -->
    <section class="section-sm">
      <div class="wrap">
        <span class="eyebrow reveal" style="display:block; margin-bottom: 0;">ALL PIECES</span>
      </div>
      <div class="posts-list">
        <div class="wrap">
          {rest.map((post, i) => (
            <div class="reveal" style={`transition-delay: ${i * 50}ms`} data-post-category={post.data.category.toLowerCase()}>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                category={post.data.category}
                slug={post.id}
                readTime={post.data.readTime}
                index={i}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- Marquee strip -->
    <div class="marquee-wrap" aria-hidden="true">
      <div class="marquee">
        <div class="marquee__track">
          <span class="marquee__item">TEARDOWNS</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item marquee__item--outline">FIELD NOTES</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item">AI SYSTEMS</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item marquee__item--outline">IOT & EDGE</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item">DESIGN CRITIQUE</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item marquee__item--outline">ENGINEERING</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item">BENGALURU</span>
          <span class="marquee__sep"></span>
          <!-- duplicate -->
          <span class="marquee__item">TEARDOWNS</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item marquee__item--outline">FIELD NOTES</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item">AI SYSTEMS</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item marquee__item--outline">IOT & EDGE</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item">DESIGN CRITIQUE</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item marquee__item--outline">ENGINEERING</span>
          <span class="marquee__sep"></span>
          <span class="marquee__item">BENGALURU</span>
          <span class="marquee__sep"></span>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Hero grid */
  .hero-grid {
    align-items: end;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .hero-copy {
    grid-column: 1 / 8;
  }
  .hero-aside {
    grid-column: 9 / -1;
    padding-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: flex-end;
  }
  .hero-lede {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 32ch;
  }
  .hero-stat {
    margin: 0;
  }

  /* Filter bar */
  .filter-bar {
    background: var(--paper-2);
  }
  .filter-inner {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filter-inner::-webkit-scrollbar { display: none; }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: transparent;
    border: 0;
    border-right: 1px solid var(--rule);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
    white-space: nowrap;
  }
  .filter-num {
    color: var(--flare);
    font-size: 0.625rem;
  }
  .filter-btn:last-child { border-right: none; }
  .filter-btn:hover,
  .filter-btn.active {
    color: var(--ink);
    background: var(--paper);
  }
  .filter-btn.active { font-weight: 700; }

  /* Featured row */
  .featured-section { padding-bottom: clamp(2rem, 4vw, 3rem); }

  .featured-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--ink);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.15s cubic-bezier(.7,0,.2,1),
                color 0.15s cubic-bezier(.7,0,.2,1),
                border-color 0.15s cubic-bezier(.7,0,.2,1);
  }

  .featured-row:hover {
    background-color: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .featured-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .featured-row__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .featured-row__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4.5vw, 3.5rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
    transition: color 0.15s;
    max-width: 22ch;
  }

  .featured-row__desc {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 60ch;
    transition: color 0.15s cubic-bezier(.7,0,.2,1);
  }

  .featured-row:hover .featured-row__desc {
    color: var(--paper);
    opacity: 0.7;
  }

  .featured-row:hover .featured-row__meta .eyebrow {
    color: var(--paper) !important;
    opacity: 0.6;
  }

  .featured-row:hover .featured-row__meta .eyebrow[style*="var(--flare)"] {
    color: var(--flare) !important;
    opacity: 1;
  }

  .featured-row__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    flex-shrink: 0;
    padding-top: 0.25rem;
    transition: color 0.15s;
  }

  .featured-row__cta .eyebrow {
    color: var(--flare);
  }

  .featured-row:hover .featured-row__cta svg {
    transform: translate(2px, -2px);
  }
  .featured-row__cta svg {
    transition: transform 0.25s cubic-bezier(.7,0,.2,1);
  }

  /* Posts list */
  .posts-list {
    padding-top: 1rem;
  }

  /* Marquee */
  .marquee-wrap {
    overflow: hidden;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1rem 0;
    background: var(--paper-2);
  }
  .marquee {
    overflow: hidden;
  }
  .marquee__track {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: max-content;
    animation: marquee 28s linear infinite;
  }
  .marquee__item {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.375rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--ink);
  }
  .marquee__item--outline {
    -webkit-text-stroke: 1.5px var(--ink);
    color: transparent;
  }
  .marquee__sep {
    display: block;
    width: 7px;
    height: 7px;
    background: var(--flare);
    flex-shrink: 0;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .hero-copy { grid-column: 1 / -1; }
    .hero-aside { grid-column: 1 / -1; flex-direction: row; align-items: flex-end; gap: 2.5rem; }
    .hero-lede { max-width: 100%; }
  }

  @media (max-width: 620px) {
    .hero-aside { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    .featured-row { flex-direction: column; }
    .featured-row__cta { flex-direction: row; align-items: center; }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.getAttribute('data-category');
      const rows = document.querySelectorAll<HTMLElement>('[data-post-category]');

      rows.forEach(row => {
        if (category === 'all' || row.getAttribute('data-post-category') === category) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
