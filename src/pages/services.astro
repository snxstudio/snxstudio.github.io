---
import Layout from '../layouts/Layout.astro';

const capabilities = [
  {
    id: 'ai',
    num: '01',
    title: 'AI / LLM Systems',
    lede: 'Production AI that survives its second quarter — not a thin wrapper around a chat completion.',
    body: [
      'We build agentic systems on modern foundation models with explicit tool boundaries, prompt-cached pipelines, structured outputs, and observability baked in from the first sprint. The patterns here come from our own shipped work — a freight platform where AI touches every stage of the workflow, from document ingestion to carrier negotiation.',
      'MCP servers for proprietary data, eval harnesses, drift monitoring, cost and latency tuning across model families. If you need it to run at scale and be explainable to a sceptical CTO, that is the work.',
    ],
    skills: ['Agentic systems', 'Prompt-cached RAG', 'MCP servers', 'Structured outputs', 'Evals & observability', 'Cost/latency tuning', 'Anthropic SDK', 'Agent SDK'],
  },
  {
    id: 'iot',
    num: '02',
    title: 'IoT & Edge Systems',
    lede: 'Hardware to dashboard. No mystery telemetry, no missing layer.',
    body: [
      'Connected devices generate enormous potential and enormous complexity. We bridge the physical and the digital: edge intelligence on constrained hardware, compressed transit over flaky networks, time-series pipelines that hold up under 24/7 ingestion, and dashboards that operations actually opens.',
      'We bring the lessons from a smart-energy-meter platform recognised by the Ministry of Power & Coal, and an agritech sensor mesh that landed a published research paper and a ~38% reduction in water use across pilot farms.',
    ],
    skills: ['Sensor & gateway architecture', 'Edge compute (Rust / C++)', 'MQTT & LoRaWAN', 'TimescaleDB / InfluxDB', 'Operations dashboards', 'Embedded C', 'Raspberry Pi', 'Arduino'],
  },
  {
    id: 'web',
    num: '03',
    title: 'Web Platforms',
    lede: 'Type-safe, production-first. Designed to outlast the team that built it.',
    body: [
      'Modern web applications that perform under load and survive their fifth product manager. We pick the right tool per layer: Next.js when it earns its complexity, Astro when it does not, NestJS where structure pays off, edge functions where they actually cost less.',
      'We pair architecture with considered UI engineering — so the product feels deliberate from the moment a user touches it. Postgres schemas you will not regret, background jobs, queues, and a performance foundation that does not need retrofitting.',
    ],
    skills: ['Next.js / Astro', 'NestJS', 'Type-safe APIs (tRPC / GraphQL)', 'PostgreSQL', 'Background jobs & queues', 'Performance & SEO foundations', 'Edge functions', 'CI/CD'],
  },
  {
    id: 'cloud',
    num: '04',
    title: 'Cloud & DevEx',
    lede: 'Boring infrastructure. Beautiful pipelines. Invisible — until it saves you.',
    body: [
      'Reliable infrastructure does its job and gets out of the way. We design cloud architectures that scale without surprises — infrastructure-as-code, automated deploys, and observability that someone actually reads rather than ignores.',
      'Cost optimisation, security posture, and compliance are part of the bones. We have shipped SOC2-shaped infra from day one on production platforms, not as a retro-fit.',
    ],
    skills: ['AWS / GCP architecture', 'Terraform IaC', 'CI/CD pipelines', 'Kubernetes', 'Observability (Datadog / Grafana)', 'SOC2 posture', 'Cost optimisation', 'Security hardening'],
  },
  {
    id: 'strategy',
    num: '05',
    title: 'Strategy & Advisory',
    lede: 'A senior brain in the room — on the decisions that compound.',
    body: [
      'For early-stage teams and investors: architecture reviews, independent technical due diligence, and a senior engineering perspective on the calls that matter. Not a consultancy with a deck.',
      'We help you avoid the architectural decisions you will regret in 18 months, the hires you will regret in 6, and the integrations you will regret in 2. Engaged on specific questions, not on retainer theatre.',
    ],
    skills: ['Architecture reviews', 'Technical due diligence', 'Engineering roadmaps', 'Investor-ready technical narratives', 'Workshops', 'Hiring assessment', 'Stack audits', 'Risk triage'],
  },
  {
    id: 'design',
    num: '06',
    title: 'UI / UX & Design Systems',
    lede: 'Opinions backed by craft. Sometimes the kind that end up as a public teardown.',
    body: [
      'Design systems are shared languages, not component libraries. We build token-driven systems that encode brand, accessibility, and interaction at the same level as code — Figma libraries kept in sync with production components.',
      'We also do structured UX audits: evidence-based teardowns of broken flows. The kind of work that becomes public field-notes — like the IRCTC Tatkal solution document.',
    ],
    skills: ['Token-driven design systems', 'Component library & Storybook', 'WCAG 2.2 audits', 'Heuristic UX teardowns', 'Figma-to-code sync', 'Tailwind', 'Interaction design', 'Accessibility'],
  },
  {
    id: 'agritech',
    num: '07',
    title: 'AgriTech Systems',
    lede: 'Sensors, soil, sky — and the dashboard the field officer actually opens.',
    body: [
      'Low-power sensor meshes, edge intelligence on cheap hardware, and dashboards built for the low-bandwidth realities of rural deployments. We treat the regional advisor as the primary user, not the farmer — because they are the one making the irrigation call.',
      'We bring lessons from a published agritech sensor deployment that delivered a ~38% water-use reduction across pilot farms and influenced subsequent regional rollouts.',
    ],
    skills: ['LoRa / LoRaWAN sensor architecture', 'Soil moisture & micro-climate telemetry', 'Low-bandwidth advisor dashboards', 'On-device decisioning', 'Pilot design & field instrumentation', 'Edge ML', 'InfluxDB', 'Grafana'],
  },
];

const marqueeItems = [
  'AI / LLM SYSTEMS', 'IoT & EDGE', 'WEB PLATFORMS', 'CLOUD DEVEX', 'STRATEGY', 'UI / UX', 'AGRITECH',
  'AI / LLM SYSTEMS', 'IoT & EDGE', 'WEB PLATFORMS', 'CLOUD DEVEX', 'STRATEGY', 'UI / UX', 'AGRITECH',
];
---

<Layout
  title="Services — SNX Studio"
  description="Seven engineering and design disciplines practised by a focused studio in Bengaluru. AI systems, IoT, web platforms, cloud, strategy, UX, and AgriTech."
>
  <main>

    <!-- ── HERO ─────────────────────────────────────────────────── -->
    <section class="section" style="padding-top: calc(78px + clamp(3.5rem, 7vw, 6rem));">
      <div class="wrap">
        <div class="grid12">
          <div style="grid-column: 1 / 11;" class="reveal">
            <p class="eyebrow" style="margin-bottom: 2rem;">(00) — CAPABILITIES</p>
            <h1 class="display" style="max-width: none;">
              Seven disciplines.<br/>
              <span style="color: var(--ink-2);">One studio.</span>
            </h1>
          </div>
          <div style="grid-column: 1 / 8; margin-top: 2.5rem;" class="reveal reveal-d1">
            <p class="lede">
              Not a generalist agency. A focused team built around senior engineering,
              opinionated design, and a deep bet on AI as the foundation of the next decade.
              Based in Bengaluru, working with teams globally.
            </p>
          </div>
          <div style="grid-column: 9 / -1; align-self: end; margin-top: 2.5rem;" class="reveal reveal-d2">
            <p class="mono" style="margin-bottom: 1rem; color: var(--muted);">ESTABLISHED</p>
            <p class="numeral" style="font-size: clamp(3rem, 6vw, 5rem); line-height: 0.9;">2024</p>
            <p class="mono" style="margin-top: 0.75rem; color: var(--muted);">BENGALURU, IN</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ── MARQUEE ────────────────────────────────────────────────── -->
    <div class="marquee" aria-hidden="true" style="padding: 1.25rem 0; border-bottom: 1px solid var(--rule); overflow: hidden;">
      <div class="marquee__track">
        {marqueeItems.map((item, i) => (
          <>
            <span class="marquee__item">{item}</span>
            <span class="marquee__sep" aria-hidden="true"></span>
          </>
        ))}
      </div>
    </div>

    <!-- ── CAPABILITY BLOCKS ─────────────────────────────────────── -->
    {capabilities.map((cap, i) => (
      <>
        <section id={cap.id} class="section cap-block">
          <div class="wrap">
            <div class="grid12 cap-grid">

              <!-- Index column -->
              <div class="cap-index reveal" style="grid-column: 1 / 2;">
                <p class="numeral cap-numeral">{cap.num}</p>
              </div>

              <!-- Main body column -->
              <div class="cap-body reveal reveal-d1" style="grid-column: 2 / 10;">
                <p class="eyebrow" style="margin-bottom: 1.5rem;">({cap.num}) — {cap.title.toUpperCase()}</p>
                <h2 class="cap-h2">{cap.title}</h2>
                <p class="cap-lede">{cap.lede}</p>
                {cap.body.map(para => (
                  <p class="cap-para">{para}</p>
                ))}
              </div>

              <!-- Skills column -->
              <div class="cap-skills reveal reveal-d2" style="grid-column: 10 / -1;">
                <p class="mono" style="margin-bottom: 1rem; color: var(--muted);">SKILLS</p>
                <ul class="skills-list" role="list">
                  {cap.skills.map(skill => (
                    <li class="skill-tag">{skill}</li>
                  ))}
                </ul>
              </div>

            </div>
          </div>
        </section>
        <hr class="rule" />
      </>
    ))}

    <!-- ── PROCESS NOTE ───────────────────────────────────────────── -->
    <section class="section-sm">
      <div class="wrap">
        <div class="grid12">
          <div style="grid-column: 1 / 5;" class="reveal">
            <p class="eyebrow" style="margin-bottom: 2rem;">(08) — HOW WE ENGAGE</p>
            <p class="numeral" style="font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 0.9; margin-bottom: 1rem;">3</p>
            <p class="mono" style="color: var(--muted);">ENGAGEMENT MODES</p>
          </div>
          <div style="grid-column: 5 / -1;" class="reveal reveal-d1">
            <ol class="engage-list" role="list">
              <li class="engage-row row-invert">
                <span class="eyebrow" style="color: var(--muted); min-width: 2.5rem;">I.</span>
                <div>
                  <p style="font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; margin-bottom: 0.25rem;">Project-based</p>
                  <p class="row-muted" style="font-size: 0.9rem; line-height: 1.55; color: var(--ink-2);">Scoped delivery: a defined thing with a defined end. We scope tight, ship fast, and hand over clean.</p>
                </div>
              </li>
              <li class="engage-row row-invert">
                <span class="eyebrow" style="color: var(--muted); min-width: 2.5rem;">II.</span>
                <div>
                  <p style="font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; margin-bottom: 0.25rem;">Embedded</p>
                  <p class="row-muted" style="font-size: 0.9rem; line-height: 1.55; color: var(--ink-2);">We join your team as a senior technical layer — architecture, decisions, code review, the things that compound.</p>
                </div>
              </li>
              <li class="engage-row row-invert">
                <span class="eyebrow" style="color: var(--muted); min-width: 2.5rem;">III.</span>
                <div>
                  <p style="font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; margin-bottom: 0.25rem;">Advisory</p>
                  <p class="row-muted" style="font-size: 0.9rem; line-height: 1.55; color: var(--ink-2);">Technical due diligence, architecture review, hiring assessment. Engaged on a question, not a retainer.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ── CTA ───────────────────────────────────────────────────── -->
    <section class="section">
      <div class="wrap">
        <div class="grid12">
          <div style="grid-column: 1 / 10;" class="reveal">
            <p class="eyebrow" style="margin-bottom: 2.5rem;">(09) — START A PROJECT</p>
            <h2 class="display" style="font-size: clamp(2.5rem, 7vw, 8rem);">
              Tell us<br/>
              what you<br/>
              <span style="color: var(--flare);">are building.</span>
            </h2>
            <p style="font-family: var(--font-sans); font-size: clamp(1rem, 1.4vw, 1.2rem); color: var(--ink-2); line-height: 1.6; margin-top: 2rem; max-width: 42ch;">
              We reply within one working day, from a real person.
              No auto-responder, no discovery call that is actually a sales call.
            </p>
            <div style="margin-top: 2.5rem; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
              <a href="/contact" class="btn btn-flare">Start a project</a>
              <a href="/work" class="btn">See selected work</a>
            </div>
          </div>
          <div style="grid-column: 10 / -1; align-self: end;" class="reveal reveal-d2">
            <p class="mono" style="margin-bottom: 0.75rem; color: var(--muted);">CURRENTLY</p>
            <div class="chip" style="display: inline-flex; align-items: center; gap: 0.5rem;">
              <span class="chip-dot"></span>
              <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink);">Available — Q3</span>
            </div>
            <p class="mono" style="margin-top: 2rem; color: var(--muted);">SNX STUDIO</p>
            <p class="mono" style="color: var(--muted);">BENGALURU, IN</p>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ── Capability blocks ───────────────────────────────────────────── */
  .cap-block {
    background: var(--paper);
  }

  .cap-grid {
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .cap-numeral {
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.85;
    color: var(--rule);
    letter-spacing: -0.03em;
    font-family: var(--font-display);
    font-weight: 800;
    padding-top: 0.35rem;
  }

  .cap-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .cap-lede {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: var(--flare);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .cap-para {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 1vw, 1.05rem);
    line-height: 1.7;
    color: var(--ink-2);
    margin-bottom: 1.1rem;
    max-width: 60ch;
  }

  .cap-index {
    padding-top: 0.25rem;
  }

  /* ── Skills list ───────────────────────────────────────────────── */
  .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.4;
    transition: color var(--snap, cubic-bezier(.7,0,.2,1)) 0.15s, padding-left var(--snap, cubic-bezier(.7,0,.2,1)) 0.15s;
  }

  .skill-tag:first-child {
    border-top: 1px solid var(--rule);
  }

  .skill-tag:hover {
    color: var(--flare);
    padding-left: 0.5rem;
  }

  /* ── Engagement list ────────────────────────────────────────────── */
  .engage-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .engage-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.5rem 1rem;
    border-bottom: 1px solid var(--rule);
    cursor: default;
    transition: background var(--snap, cubic-bezier(.7,0,.2,1)) 0.15s, color var(--snap, cubic-bezier(.7,0,.2,1)) 0.15s;
  }

  .engage-row:first-child {
    border-top: 1px solid var(--rule);
  }

  .engage-row:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .engage-row:hover p {
    color: var(--paper);
  }

  .engage-row:hover .row-muted {
    color: rgba(242, 238, 230, 0.65) !important;
  }

  .engage-row:hover .eyebrow {
    color: var(--flare) !important;
  }

  /* ── Responsive overrides ───────────────────────────────────────── */
  @media (max-width: 900px) {
    .cap-grid {
      display: flex;
      flex-direction: column;
    }

    .cap-index {
      display: none;
    }

    .cap-skills {
      border-top: 1px solid var(--rule);
      padding-top: 1.5rem;
    }

    .skills-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .skill-tag {
      border: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
      padding: 0.3rem 0.6rem;
    }

    .skill-tag:first-child {
      border-top: 1px solid var(--rule);
    }

    .skill-tag:hover {
      padding-left: 0.6rem;
    }
  }

  @media (max-width: 640px) {
    .engage-row {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
