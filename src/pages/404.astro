---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Marks.astro';

const suggestions = [
  { num: '01', label: 'Studio', href: '/about' },
  { num: '02', label: 'Selected work', href: '/work' },
  { num: '03', label: 'Services', href: '/services' },
  { num: '04', label: 'Open source', href: '/opensource' },
  { num: '05', label: 'Field notes', href: '/blog' },
  { num: '06', label: 'Contact', href: '/contact' },
];
---

<Layout title="404 — Page not found" description="That page walked off the grid. Pick a different door — the studio is still very much in." noindex={true}>
  <Nav />
  <main class="not-found">
    <div class="nf-grid-bg" aria-hidden="true"></div>

    <section class="nf-inner">
      <!-- Top meta row -->
      <div class="nf-top animate-fade-in delay-100">
        <span class="nf-top-mark">ERROR&#8201;/&#8201;404</span>
        <span class="nf-top-tag">Page not found</span>
      </div>

      <!-- Full-bleed wordmark — middle zero is the accent -->
      <h1 class="nf-word animate-fade-in-up delay-200" aria-label="404">
        4<span class="nf-word-zero">0</span>4
      </h1>

      <!-- Caption rule -->
      <div class="nf-caption animate-fade-in delay-300">
        <span class="nf-caption-l">This page walked off the grid</span>
        <span class="nf-caption-rule" aria-hidden="true"></span>
        <span class="nf-caption-r">or never existed</span>
      </div>

      <!-- Belt: lede + actions -->
      <div class="nf-belt animate-fade-in-up delay-400">
        <p class="nf-lede">
          Either the URL is wrong or the page has been retired. Use the index
          below to find your way, or <em>head back to the homepage.</em>
        </p>
        <div class="nf-actions">
          <a href="/" class="btn-primary">
            Back to homepage
            <Mark name="arrow-r" class="btn-mark" />
          </a>
          <a href="/contact" class="btn-ghost">Get in touch</a>
        </div>
      </div>

      <!-- Index rail -->
      <nav class="nf-index animate-fade-in delay-500" aria-label="Site index">
        <ol role="list">
          {suggestions.map((s) => (
            <li>
              <a href={s.href} class="nf-row">
                <span class="nf-row-num numeral">{s.num}</span>
                <span class="nf-row-label">{s.label}</span>
                <Mark name="arrow-r" class="nf-row-arrow" />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    position: relative;
    overflow-x: clip;
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: clamp(5.5rem, 12vh, 8rem);
    padding-bottom: clamp(3rem, 6vh, 5rem);
  }

  /* Dotted grid texture — matches hero */
  .nf-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--dot) 1.4px, transparent 1.4px);
    background-size: 24px 24px;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 90%, transparent);
            mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 90%, transparent);
  }

  .nf-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  /* ── Top meta row ── */
  .nf-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding-bottom: clamp(1rem, 4vh, 2.5rem);
  }
  .nf-top-mark { color: var(--ink); }
  .nf-top-tag { flex: 1; text-align: right; }

  /* ── Full-bleed wordmark ── */
  .nf-word {
    margin: 0;
    width: 100%;
    min-width: 0;
    overflow: clip;
    font-family: var(--font-wordmark);
    font-weight: 800;
    font-size: clamp(7rem, 38vw, 30rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-align: center;
    white-space: nowrap;
  }
  .nf-word-zero {
    color: var(--accent);
    position: relative;
  }

  /* ── Caption rule ── */
  .nf-caption {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vh, 2rem);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.85rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .nf-caption-l { color: var(--ink); }
  .nf-caption-rule {
    flex: 1;
    height: 1px;
    background: var(--border-strong);
  }
  .nf-caption-r { white-space: nowrap; }

  /* ── Belt: lede + actions ── */
  .nf-belt {
    margin-top: clamp(2rem, 5vh, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
  }
  .nf-lede {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 56ch;
  }
  .nf-lede em {
    font-style: normal;
    font-weight: 600;
    color: var(--ink);
  }
  .nf-actions {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    justify-self: end;
  }
  .btn-mark { width: 30px; height: 14px; }

  /* ── Index rail ── */
  .nf-index {
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .nf-index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }
  .nf-index li {
    border-bottom: 1px solid var(--border);
  }
  .nf-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0.25rem;
    color: var(--ink);
    transition: padding 0.3s ease, background-color 0.3s ease;
  }
  .nf-row:hover {
    padding-left: 1rem;
    background: var(--bg-alt);
  }
  .nf-row-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .nf-row-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    letter-spacing: -0.02em;
  }
  .nf-row-arrow {
    width: 36px;
    height: 14px;
    justify-self: end;
    color: var(--muted);
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.3s ease, color 0.3s ease, transform 0.4s ease;
  }
  .nf-row:hover .nf-row-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translateX(0);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nf-top { flex-wrap: wrap; gap: 0.5rem 1rem; }
    .nf-top-tag { flex-basis: 100%; order: 3; text-align: left; }
    .nf-word { font-size: clamp(5rem, 46vw, 12rem); }
    .nf-caption { flex-wrap: wrap; gap: 0.5rem; }
    .nf-caption-rule { flex-basis: 100%; }
    .nf-belt { grid-template-columns: 1fr; align-items: start; }
    .nf-actions { justify-self: start; }
    .nf-index ol { grid-template-columns: 1fr; }
  }
</style>
