---
import Layout from '../layouts/Layout.astro';

const pages = [
  { num: '01', label: 'Selected work', href: '/work' },
  { num: '02', label: 'Services', href: '/services' },
  { num: '03', label: 'Open source', href: '/opensource' },
  { num: '04', label: 'Journal', href: '/blog' },
  { num: '05', label: 'Contact', href: '/contact' },
];
---

<Layout title="404 — Page not found" description="That URL doesn't resolve to anything. Try a different door.">
  <main class="nf">
    <section class="section nf-section">
      <div class="wrap">
        <div class="nf-grid">

          <!-- Left column -->
          <div class="nf-left">
            <span class="eyebrow reveal" style="color: var(--flare);">ERROR — 404</span>
            <p class="nf-line reveal reveal-d1">
              That page walked off. The studio is still very much in.
            </p>
            <p class="nf-sub reveal reveal-d2">
              Either the URL is wrong, the path was retired, or some other small indignity has occurred.
              Pick a different door below.
            </p>

            <nav class="nf-nav reveal reveal-d2" aria-label="Suggested pages">
              {pages.map(p => (
                <a href={p.href} class="nf-nav-row row-invert">
                  <span class="eyebrow nf-nav-num">{p.num}</span>
                  <span class="nf-nav-label">{p.label}</span>
                  <svg class="nf-nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7,7 17,7 17,17"/>
                  </svg>
                </a>
              ))}
            </nav>

            <div class="nf-actions reveal reveal-d3">
              <a href="/" class="btn">
                <span class="eyebrow">HOME</span>
              </a>
              <a href="/contact" class="btn btn-flare">
                <span class="eyebrow">CONTACT</span>
              </a>
            </div>
          </div>

          <!-- Right: giant 404 numeral -->
          <div class="nf-right" aria-hidden="true">
            <span class="nf-numeral">404</span>
            <div class="nf-stamp-line">
              <span class="eyebrow" style="color: var(--muted);">SNX STUDIO — BENGALURU</span>
              <span class="nf-stamp-dash"></span>
              <span class="eyebrow" style="color: var(--flare);">PAGE NOT FOUND</span>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .nf {
    padding-top: calc(78px + clamp(3rem, 6vw, 5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
    min-height: 80vh;
    display: flex;
    align-items: center;
  }
  .nf-section {
    width: 100%;
    padding-top: 0;
    padding-bottom: 0;
  }

  .nf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
  }

  /* Left */
  .nf-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nf-line {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.0;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 0;
    max-width: 20ch;
  }

  .nf-sub {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 42ch;
    margin: 0;
  }

  /* Nav rows */
  .nf-nav {
    border-top: 1px solid var(--rule);
    margin-top: 0.5rem;
  }

  .nf-nav-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1.5rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.12s cubic-bezier(.7,0,.2,1),
                color 0.12s cubic-bezier(.7,0,.2,1);
  }

  .nf-nav-row:hover {
    background-color: var(--ink);
    color: var(--paper);
    padding-left: 1rem;
    border-bottom-color: var(--ink);
  }

  .nf-nav-num {
    color: var(--flare);
  }

  .nf-nav-row:hover .nf-nav-num {
    color: var(--flare);
  }

  .nf-nav-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    letter-spacing: -0.02em;
    transition: inherit;
  }

  .nf-nav-arrow {
    color: var(--muted);
    transition: transform 0.2s, color 0.12s;
    justify-self: end;
  }

  .nf-nav-row:hover .nf-nav-arrow {
    transform: translate(2px, -2px);
    color: var(--paper);
  }

  /* Actions */
  .nf-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Right — giant numeral */
  .nf-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .nf-numeral {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(7rem, 18vw, 18rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    display: block;
    animation: nf-in 0.6s cubic-bezier(.16,1,.3,1) both;
    transform-origin: right center;
    user-select: none;
  }

  .nf-stamp-line {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nf-stamp-dash {
    display: block;
    width: 6px;
    height: 6px;
    background: var(--flare);
    flex-shrink: 0;
  }

  @keyframes nf-in {
    from {
      opacity: 0;
      transform: translateX(2rem) skewX(-4deg);
    }
    to {
      opacity: 1;
      transform: translateX(0) skewX(0);
    }
  }

  @media (max-width: 820px) {
    .nf-grid {
      grid-template-columns: 1fr;
    }
    .nf-right {
      order: -1;
      align-items: flex-start;
    }
    .nf-numeral {
      font-size: clamp(6rem, 22vw, 10rem);
    }
    .nf-stamp-line {
      justify-content: flex-start;
    }
  }
</style>
