---
import StatusLayout from '../layouts/StatusLayout.astro';

const routes = [
  {
    code: 'AGR-24',
    name: 'AgriGrid',
    kind: 'field sensors / irrigation logic',
    color: 'route-green',
    stops: ['brief', 'model', 'build', 'field', 'ops'],
    active: 4,
  },
  {
    code: 'IRC-14',
    name: 'IRCTC report',
    kind: 'public teardown / reliability audit',
    color: 'route-blue',
    stops: ['brief', 'model', 'build', 'field', 'ops'],
    active: 4,
  },
  {
    code: 'OBS-03',
    name: 'Meta-observability',
    kind: 'internal error tracking',
    color: 'route-red',
    stops: ['brief', 'model', 'build', 'field', 'ops'],
    active: 3,
  },
  {
    code: 'SUB-01',
    name: 'Substation edge inference',
    kind: 'benchmark review / prototype',
    color: 'route-amber',
    stops: ['brief', 'model', 'build', 'field', 'ops'],
    active: 1,
  },
];

const capabilities = [
  ['AI systems', 'agents, retrieval, evals, workflow automation'],
  ['Industrial IoT', 'edge telemetry, device data, field dashboards'],
  ['Web platforms', 'ops portals, reporting surfaces, internal tools'],
  ['Cloud / DevEx', 'deployment rails, observability, backend services'],
];

const log = [
  ['2026-05-14 09:38', 'AGR-24', 'edge runtime patch moved to ops'],
  ['2026-05-14 08:11', 'IRC-14', 'v1.4 report released'],
  ['2026-05-13 22:40', 'OBS-03', 'preview deployed for internal use'],
  ['2026-05-13 17:22', 'SUB-01', 'benchmarks reviewed, build slot pending'],
];
---

<StatusLayout
  title="SNX/STUDIO - dispatch desk"
  description="SNX/STUDIO is an engineering agency in Bangalore. We route unclear industrial, AI, logistics, and public-sector problems into shipped software."
>
  <main class="dispatch">
    <header class="topbar" aria-label="Primary">
      <a class="brand" href="/">SNX/STUDIO</a>
      <span class="topbar-meta">dispatch desk / bangalore / UTC+05:30</span>
      <nav class="topbar-nav" aria-label="Primary navigation">
        <a href="/work">work</a>
        <a href="/services">capabilities</a>
        <a href="/blog">log</a>
        <a href="/contact">availability</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="dispatch-title">
      <div class="hero-copy">
        <p class="kicker">ENGINEERING AGENCY / BUILD + OPERATE</p>
        <h1 id="dispatch-title">
          We turn messy briefs into software that survives contact with the field.
        </h1>
        <p class="lede">
          SNX/STUDIO works on AI systems, industrial IoT, public infrastructure,
          logistics, and internal platforms. The site is now a dispatch board:
          every line below is a job moving through the studio.
        </p>
      </div>

      <aside class="intake" aria-label="Current availability">
        <div class="intake-row">
          <span>next build slot</span>
          <strong>Q3 2026</strong>
        </div>
        <div class="intake-row">
          <span>new engagements</span>
          <strong>01</strong>
        </div>
        <div class="intake-row">
          <span>first response</span>
          <strong>24h</strong>
        </div>
        <a class="intake-link" href="/contact">route a project -></a>
      </aside>
    </section>

    <section class="route-board" aria-labelledby="route-title">
      <div class="board-head">
        <div>
          <p class="kicker">ACTIVE ROUTES</p>
          <h2 id="route-title">Studio work in motion</h2>
        </div>
        <div class="board-key" aria-label="Route stages">
          <span>brief</span>
          <span>model</span>
          <span>build</span>
          <span>field</span>
          <span>ops</span>
        </div>
      </div>

      <div class="routes">
        {routes.map((route) => (
          <article class={`route ${route.color}`}>
            <div class="route-id">
              <strong>{route.code}</strong>
              <span>{route.name}</span>
            </div>
            <div class="route-line" aria-label={`${route.name} route progress`}>
              {route.stops.map((stop, index) => (
                <span
                  class={`station ${index < route.active ? 'is-past' : ''}${index === route.active ? ' is-active' : ''}`}
                  title={stop}
                >
                  <span class="station-label">{stop}</span>
                </span>
              ))}
            </div>
            <p>{route.kind}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="lower-grid" aria-label="Agency operating model">
      <div class="capability-stack">
        <div class="section-head">
          <p class="kicker">WHAT GETS ROUTED</p>
          <h2>Capabilities</h2>
        </div>
        <div class="capabilities">
          {capabilities.map(([name, detail]) => (
            <article>
              <h3>{name}</h3>
              <p>{detail}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="log-card">
        <div class="section-head">
          <p class="kicker">RECENT MOVES</p>
          <h2>Work log</h2>
        </div>
        <ol>
          {log.map(([time, code, text]) => (
            <li>
              <time>{time}</time>
              <strong>{code}</strong>
              <span>{text}</span>
            </li>
          ))}
        </ol>
      </aside>
    </section>

    <footer class="dispatch-foot">
      <span>SNX/STUDIO / engineering agency</span>
      <a href="mailto:mayur@snxstudio.com">mayur@snxstudio.com</a>
    </footer>
  </main>
</StatusLayout>

<style>
  .dispatch {
    width: min(1440px, 100%);
    min-height: 100dvh;
    margin: 0 auto;
    padding: 18px;
  }

  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    min-height: 44px;
    border-bottom: 2px solid var(--ink);
    font-size: 12px;
  }

  .brand {
    font-weight: 800;
    font-size: 15px;
  }

  .topbar-meta {
    color: var(--ink-2);
  }

  .topbar-nav {
    display: flex;
    gap: 14px;
  }

  .topbar-nav a {
    color: var(--ink-2);
  }

  .topbar-nav a:hover,
  .dispatch a:hover {
    color: var(--route-blue);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: 28px;
    padding: 34px 0 28px;
    border-bottom: 1px solid var(--rule-strong);
  }

  .kicker {
    margin: 0 0 10px;
    color: var(--ink-2);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero h1 {
    max-width: 980px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 7.3vw, 112px);
    font-weight: 800;
    line-height: 0.88;
  }

  .lede {
    max-width: 760px;
    margin: 22px 0 0;
    color: var(--ink-2);
    font-size: clamp(14px, 1.45vw, 18px);
    line-height: 1.55;
  }

  .intake {
    align-self: stretch;
    display: grid;
    border: 2px solid var(--ink);
    background: var(--bg-panel);
  }

  .intake-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 14px;
    padding: 14px;
    border-bottom: 1px solid var(--rule);
  }

  .intake-row span {
    color: var(--ink-2);
    font-size: 11px;
  }

  .intake-row strong {
    font-family: var(--font-display);
    font-size: 38px;
    line-height: 0.82;
  }

  .intake-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 0 14px;
    background: var(--ink);
    color: var(--bg-panel);
    font-weight: 800;
  }

  .route-board {
    padding: 24px 0;
    border-bottom: 1px solid var(--rule-strong);
  }

  .board-head,
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 18px;
    margin-bottom: 14px;
  }

  .board-head h2,
  .section-head h2 {
    margin: 0;
    font-size: clamp(20px, 2.8vw, 34px);
  }

  .board-key {
    display: grid;
    grid-template-columns: repeat(5, minmax(48px, 1fr));
    gap: 10px;
    width: min(620px, 55vw);
    color: var(--ink-2);
    font-size: 10px;
    text-transform: uppercase;
  }

  .routes {
    display: grid;
    gap: 8px;
  }

  .route {
    --route-color: var(--route-blue);
    display: grid;
    grid-template-columns: minmax(170px, 0.45fr) minmax(320px, 1.2fr) minmax(180px, 0.55fr);
    align-items: center;
    gap: 16px;
    min-height: 82px;
    padding: 12px;
    border: 1px solid var(--ink);
    background: var(--bg-panel);
  }

  .route-green { --route-color: var(--route-green); }
  .route-blue { --route-color: var(--route-blue); }
  .route-red { --route-color: var(--route-red); }
  .route-amber { --route-color: var(--route-amber); }

  .route-id {
    display: grid;
    gap: 5px;
  }

  .route-id strong {
    width: fit-content;
    padding: 4px 7px;
    background: var(--route-color);
    color: var(--route-label);
    font-size: 12px;
  }

  .route-id span,
  .route p {
    color: var(--ink-2);
    font-size: 12px;
  }

  .route p {
    margin: 0;
  }

  .route-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    align-items: center;
  }

  .route-line::before {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    top: 50%;
    height: 5px;
    background: var(--rule);
    transform: translateY(-50%);
  }

  .station {
    position: relative;
    z-index: 1;
    display: block;
    height: 30px;
    border: 2px solid var(--ink);
    background: var(--bg-panel);
  }

  .station.is-past {
    background: color-mix(in srgb, var(--route-color) 24%, var(--bg-panel));
  }

  .station.is-active {
    background: var(--route-color);
  }

  .station-label {
    position: absolute;
    top: 35px;
    left: 0;
    color: var(--ink-3);
    font-size: 9px;
    text-transform: uppercase;
  }

  .lower-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.62fr);
    gap: 18px;
    padding: 24px 0 18px;
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--ink);
    background: var(--bg-panel);
  }

  .capabilities article {
    min-height: 150px;
    padding: 14px;
    border-right: 1px solid var(--rule);
  }

  .capabilities article:last-child {
    border-right: 0;
  }

  .capabilities h3 {
    margin: 0 0 36px;
    font-size: 14px;
  }

  .capabilities p {
    margin: 0;
    color: var(--ink-2);
    font-size: 12px;
  }

  .log-card {
    border: 1px solid var(--ink);
    background: var(--bg-panel);
    padding: 14px;
  }

  .log-card .section-head {
    margin-bottom: 10px;
  }

  .log-card ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log-card li {
    display: grid;
    grid-template-columns: 112px 64px 1fr;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    font-size: 11px;
  }

  .log-card time {
    color: var(--ink-3);
  }

  .log-card strong {
    color: var(--ink);
  }

  .log-card span {
    color: var(--ink-2);
  }

  .dispatch-foot {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
    color: var(--ink-2);
    font-size: 11px;
  }

  .dispatch-foot a {
    color: var(--ink);
  }

  @media (max-width: 980px) {
    .topbar,
    .hero,
    .lower-grid {
      grid-template-columns: 1fr;
    }

    .topbar-nav {
      flex-wrap: wrap;
    }

    .route {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .board-head {
      align-items: start;
      flex-direction: column;
    }

    .board-key {
      width: 100%;
    }

    .capabilities {
      grid-template-columns: 1fr 1fr;
    }

    .capabilities article:nth-child(2) {
      border-right: 0;
    }

    .capabilities article:nth-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }
  }

  @media (max-width: 620px) {
    .dispatch {
      padding: 12px;
    }

    .hero h1 {
      font-size: clamp(38px, 15vw, 64px);
    }

    .route-line,
    .board-key {
      grid-template-columns: repeat(5, minmax(42px, 1fr));
      gap: 6px;
    }

    .station {
      height: 24px;
    }

    .station-label {
      display: none;
    }

    .capabilities {
      grid-template-columns: 1fr;
    }

    .capabilities article,
    .capabilities article:nth-child(2) {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .capabilities article:last-child {
      border-bottom: 0;
    }

    .log-card li {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .dispatch-foot {
      flex-direction: column;
    }
  }
</style>
