---
import Layout from '../layouts/Layout.astro';

const work = [
  {
    idx: '01',
    name: 'agrigrid',
    desc: 'Low-power LoRa sensor mesh and advisor dashboard for small-holder farms — soil, micro-climate, irrigation, built for the field officer making the call.',
    tags: ['IoT', 'EDGE ML', 'AGRITECH'],
    year: '2024',
    href: '/work',
  },
  {
    idx: '02',
    name: 'IRCTC Tatkal teardown',
    desc: 'A structured, evidence-based UX teardown of India’s most contested booking flow — and the architecture we would ship to fix it.',
    tags: ['UX AUDIT', 'STRATEGY', 'WRITING'],
    year: '2025',
    href: '/blog',
  },
  {
    idx: '03',
    name: 'meta-obs',
    desc: 'Observability layer for LLM systems: traces, evals, drift and cost across model families, designed so the on-call engineer actually opens it.',
    tags: ['AI/LLM', 'CLOUD', 'DEVEX'],
    year: '2025',
    href: '/work',
  },
  {
    idx: '04',
    name: 'lit-pigeon',
    desc: 'Drag-and-drop email editor as web components. Exports clean MJML and HTML. MIT-licensed, runs in production.',
    tags: ['WEB', 'OPEN SOURCE', 'UI/UX'],
    year: '2024',
    href: 'https://wearesnx.studio/lit-pigeon/',
    external: true,
  },
];

const capabilities = [
  { num: '01', title: 'AI / LLM Systems', body: 'Agents with hard tool boundaries, prompt-cached pipelines, MCP servers, evals and drift monitoring. Not a wrapper around a chat completion.' },
  { num: '02', title: 'IoT & Edge', body: 'Sensor and gateway architecture, edge compute in Rust and C, MQTT and LoRa transport, time-series storage that survives flaky networks.' },
  { num: '03', title: 'Web Platforms', body: 'Type-safe product engineering that outlasts its fifth product manager. The right tool per layer — no framework worship.' },
  { num: '04', title: 'Cloud / DevEx', body: 'Infrastructure-as-code, deploys that catch things, and observability someone actually reads. Boring infra, on purpose.' },
  { num: '05', title: 'Strategy & Advisory', body: 'Architecture reviews and technical due diligence for teams and investors. A senior brain in the room, not a deck.' },
  { num: '06', title: 'UI / UX', body: 'Token-driven design systems and evidence-based teardowns. Opinions backed by craft, sometimes published in the open.' },
  { num: '07', title: 'AgriTech', body: 'Low-power meshes, on-device decisioning, and dashboards built for the low-bandwidth realities of rural deployments.' },
];

const stats = [
  { value: '2024', label: 'Established — Bengaluru' },
  { value: '07', label: 'Disciplines under one brain' },
  { value: '12+', label: 'Systems shipped to production' },
  { value: '04', label: 'Open-source projects maintained' },
];

const marquee = ['AI / LLM SYSTEMS', 'IoT & EDGE', 'WEB PLATFORMS', 'CLOUD / DEVEX', 'STRATEGY', 'UI / UX', 'AGRITECH'];
---

<Layout
  title="SNX Studio — Design & engineering, Bengaluru"
  description="SNX Studio builds AI, IoT, and web systems from Bengaluru. A small studio with a senior brain — est. 2024."
>
  <!-- ───────────────────────── (a) HERO ───────────────────────── -->
  <section class="section hero">
    <div class="wrap">
      <div class="grid12 hero__grid">
        <div class="hero__head">
          <p class="eyebrow reveal">(SNX) &mdash; STUDIO / BENGALURU / EST. 2024</p>
          <h1 class="display hero__display reveal reveal-d1">
            We build the<br />
            systems other<br />
            studios <span class="flare">wrap.</span>
          </h1>
        </div>

        <div class="hero__meta">
          <p class="lede reveal reveal-d2">
            A small design and engineering studio in Bengaluru. AI, IoT, and web
            systems, taken from a sharp idea to something that runs in production
            and survives the messy bit after launch.
          </p>
          <div class="hero__actions reveal reveal-d3">
            <a href="/contact" class="btn">Start a project &rarr;</a>
            <a href="/work" class="link-underline hero__sub">See selected work</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ───────────────────────── (b) MARQUEE ───────────────────────── -->
  <section class="marquee marquee--slow marquee-band" aria-hidden="true">
    <div class="marquee__track">
      {marquee.map((m) => (
        <span class="marquee__item">{m}<span class="marquee__sep"></span></span>
      ))}
      {marquee.map((m) => (
        <span class="marquee__item">{m}<span class="marquee__sep"></span></span>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <!-- ───────────────────────── (c) SELECTED WORK ───────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="grid12 sec-head">
        <p class="eyebrow reveal" style="grid-column: 1 / 7;">(01) &mdash; SELECTED WORK</p>
        <p class="sec-head__note reveal reveal-d1" style="grid-column: 8 / -1;">
          Built, shipped, maintained. No vapourware.
        </p>
      </div>
    </div>

    <hr class="rule work-rule" />

    <ul class="work-list" role="list">
      {work.map((w) => (
        <li class="reveal">
          <a
            href={w.href}
            class="row-invert work-row"
            target={w.external ? '_blank' : undefined}
            rel={w.external ? 'noopener noreferrer' : undefined}
          >
            <div class="wrap">
              <div class="grid12 work-row__grid">
                <span class="work-row__idx row-muted">{w.idx}</span>
                <h3 class="work-row__name">{w.name}{w.external && <span class="work-row__ext"> &nearr;</span>}</h3>
                <p class="work-row__desc row-muted">{w.desc}</p>
                <ul class="work-row__tags row-muted" role="list">
                  {w.tags.map((t) => <li>{t}</li>)}
                </ul>
                <span class="work-row__year row-muted">{w.year}</span>
              </div>
            </div>
          </a>
          <hr class="rule" />
        </li>
      ))}
    </ul>

    <div class="wrap work-footer">
      <a href="/work" class="link-underline mono reveal">Full archive &rarr;</a>
    </div>
  </section>

  <hr class="rule" />

  <!-- ───────────────────────── (d) CAPABILITIES ───────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="grid12 sec-head">
        <p class="eyebrow reveal" style="grid-column: 1 / 7;">(02) &mdash; CAPABILITIES</p>
        <h2 class="cap-head reveal reveal-d1" style="grid-column: 1 / 10;">
          Seven disciplines,<br />one brain in the room.
        </h2>
      </div>

      <ol class="cap-list" role="list">
        {capabilities.map((c) => (
          <li class="cap-item reveal">
            <span class="cap-item__num">{c.num}</span>
            <h4 class="cap-item__title">{c.title}</h4>
            <p class="cap-item__body">{c.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="rule" />

  <!-- ───────────────────────── (e) STATS ───────────────────────── -->
  <section class="section-sm stats-band">
    <div class="wrap">
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat reveal">
            <span class="numeral stat__value">{s.value}</span>
            <span class="mono stat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ───────────────────────── (f) STUDIO STATEMENT ───────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="grid12">
        <p class="eyebrow reveal" style="grid-column: 1 / -1;">(03) &mdash; APPROACH</p>
        <p class="statement reveal reveal-d1" style="grid-column: 1 / 11;">
          We are small on purpose. The senior engineer who scopes the work is the
          one who writes the code. We pick the dull, durable tool over the
          fashionable one, ship the thing that runs at 3am without a pager, and
          treat <span class="flare">the person who has to maintain it</span> as the
          real user.
        </p>
        <p class="statement__sig mono reveal reveal-d2" style="grid-column: 1 / -1;">
          &mdash; SNX STUDIO, BENGALURU
        </p>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ───────────────────────── (g) FINAL CTA ───────────────────────── -->
  <section class="section cta-band">
    <div class="wrap">
      <div class="grid12 cta__grid">
        <div class="cta__head" style="grid-column: 1 / 9;">
          <p class="eyebrow reveal">(04) &mdash; START</p>
          <h2 class="cta__display display reveal reveal-d1">
            Tell us what<br />you&rsquo;re <span class="flare">building.</span>
          </h2>
        </div>
        <div class="cta__meta" style="grid-column: 9 / -1;">
          <p class="cta__note reveal reveal-d2">
            A real person replies within one working day. Available for new work
            from Q3.
          </p>
          <a href="/contact" class="btn btn-flare cta__btn reveal reveal-d3">
            Start a project &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ───────────────────────────────────── */
  .hero {
    padding-top: clamp(4.5rem, 12vw, 9rem);
  }
  .hero__grid {
    align-items: end;
    row-gap: clamp(2rem, 5vw, 4rem);
  }
  .hero__head { grid-column: 1 / 10; }
  .hero__meta {
    grid-column: 10 / -1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 0.5rem;
  }
  .hero__display {
    margin-top: 1.5rem;
    /* let the headline bleed slightly past the left edge */
    margin-left: -0.04em;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .hero__sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .hero__head { grid-column: 1 / -1; }
    .hero__meta { grid-column: 1 / -1; }
    .hero__meta .lede { max-width: 42ch; }
  }

  /* ── MARQUEE BAND ───────────────────────────── */
  .marquee-band {
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--paper-2);
  }

  /* ── SECTION HEADS ──────────────────────────── */
  .sec-head { align-items: baseline; }
  .sec-head__note {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--ink-2);
    text-align: right;
  }
  @media (max-width: 700px) {
    .sec-head__note { text-align: left; grid-column: 1 / -1 !important; }
    .sec-head .eyebrow { grid-column: 1 / -1 !important; }
  }

  /* ── SELECTED WORK LIST ─────────────────────── */
  .work-rule { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .work-list { list-style: none; margin: 0; padding: 0; }
  .work-row { display: block; }
  .work-row__grid {
    align-items: baseline;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    row-gap: 0.75rem;
  }
  .work-row__idx {
    grid-column: 1 / 2;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 0.4rem;
  }
  .work-row__name {
    grid-column: 2 / 8;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, 4rem);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .work-row__ext {
    color: var(--flare);
    font-size: 0.5em;
    vertical-align: super;
  }
  .work-row:hover .work-row__ext { color: var(--paper); }
  .work-row__desc {
    grid-column: 8 / 12;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .work-row__tags {
    grid-column: 8 / 12;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .work-row__year {
    grid-column: 12 / -1;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 0.4rem;
  }
  .work-footer { padding-top: clamp(1.5rem, 3vw, 2.5rem); }

  @media (max-width: 820px) {
    .work-row__name { grid-column: 2 / -1; }
    .work-row__desc { grid-column: 2 / -1; }
    .work-row__tags { grid-column: 2 / -1; }
    .work-row__year { grid-column: 2 / -1; justify-self: start; }
  }

  /* ── CAPABILITIES ───────────────────────────── */
  .cap-head {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
    margin-top: 0.5rem;
  }
  .cap-list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
  }
  .cap-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    row-gap: 0.5rem;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--rule);
    align-content: start;
  }
  .cap-item__num {
    grid-row: 1 / 3;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--flare);
    padding-top: 0.4rem;
  }
  .cap-item__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .cap-item__body {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 38ch;
  }
  @media (max-width: 760px) {
    .cap-list { grid-template-columns: 1fr; }
    .cap-head { grid-column: 1 / -1 !important; }
  }

  /* ── STATS ──────────────────────────────────── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(1rem, 3vw, 3rem);
    row-gap: 2.5rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 1px solid var(--rule);
    padding-left: clamp(1rem, 2vw, 1.75rem);
  }
  .stat__value { font-size: clamp(2.5rem, 6vw, 5.5rem); }
  .stat__label {
    font-size: 0.6875rem;
    color: var(--muted);
    max-width: 18ch;
  }
  @media (max-width: 760px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── STUDIO STATEMENT ───────────────────────── */
  .statement {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.6vw, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--ink);
    text-wrap: balance;
  }
  .statement__sig {
    margin-top: 2rem;
    color: var(--muted);
  }

  /* ── CTA BAND ───────────────────────────────── */
  .cta-band { background: var(--paper-2); }
  .cta__grid { align-items: end; row-gap: 2.5rem; }
  .cta__display { margin-top: 1.25rem; }
  .cta__meta {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-bottom: 0.75rem;
  }
  .cta__note {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 30ch;
  }
  .cta__btn { align-self: flex-start; }
  @media (max-width: 900px) {
    .cta__head { grid-column: 1 / -1 !important; }
    .cta__meta { grid-column: 1 / -1 !important; }
  }
</style>
