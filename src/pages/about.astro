---
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    num: '01',
    title: 'Senior people, only.',
    desc: 'No staffing pyramid. The person scoping the work is the person shipping it. Costs more in the brochure, costs less in the runway.',
  },
  {
    num: '02',
    title: 'Opinions, then options.',
    desc: 'We will tell you what we think you should build. Then we will hear your reasons, change our minds where they should be changed, and document the rest.',
  },
  {
    num: '03',
    title: 'Production from week one.',
    desc: 'A vertical slice live in front of users in the first sprint. We refuse to spend a quarter behind closed doors before anyone touches it.',
  },
  {
    num: '04',
    title: 'AI as a first-class platform.',
    desc: 'We build on modern foundation models — not as wrappers, as foundations. Prompt-cached pipelines, MCP-shaped tools, agents with hard guardrails.',
  },
  {
    num: '05',
    title: 'Teardowns, in public.',
    desc: 'We write theses on broken systems — IRCTC Tatkal, smart-meter rollouts, freight tooling — because writing in public is the cheapest way to be honest.',
  },
];

const stats = [
  { num: '10+', label: 'Years\nshipping at the edge.' },
  { num: '02', label: 'Continents\nthe team has shipped from.' },
  { num: '04', label: 'Disciplines.\nAI · IoT · Cloud · UX.' },
  { num: 'N°1', label: 'Ministry of Power\n& Coal recognition.' },
];
---

<Layout title="Studio — SNX" description="A small, senior-led AI & technology studio based in Bengaluru. We design, build, and ship the intelligent systems behind good products.">
  <main>

    <!-- ============================================================
         HERO
    ============================================================ -->
    <section class="about-hero section">
      <div class="wrap">
        <div class="grid12">
          <div class="hero-col">
            <p class="eyebrow reveal">(00) — STUDIO NOTE</p>
            <h1 class="display hero-display reveal reveal-d1">
              A small studio.<br/>Built like a<br/>
              <span class="flare">workshop.</span>
            </h1>
          </div>
          <div class="hero-meta reveal reveal-d2">
            <p class="lede">
              SNX is a senior-led AI &amp; technology partner. The same people scope,
              design, architect, build, and stay on call after launch. The work is
              small because the quality bar is non-negotiable.
            </p>
            <ul class="hero-facts">
              <li><span class="mono">LOCATION</span><span class="fact-val">Bengaluru, India</span></li>
              <li><span class="mono">FOUNDED</span><span class="fact-val">2024</span></li>
              <li><span class="mono">FOUNDER</span><span class="fact-val">Mayur Rawte</span></li>
              <li><span class="mono">STATUS</span><span class="fact-val chip"><span class="chip-dot"></span>Accepting — Q3 2026</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ============================================================
         STATS
    ============================================================ -->
    <section class="section-sm">
      <div class="wrap">
        <div class="stats-row reveal">
          {stats.map((s) => (
            <div class="stat-cell">
              <span class="numeral stat-num">{s.num}</span>
              <span class="stat-label mono">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ============================================================
         MARQUEE — capabilities ticker
    ============================================================ -->
    <div class="marquee marquee--slow" aria-hidden="true">
      <div class="marquee__track">
        <span class="marquee__item">AI / LLM SYSTEMS</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item marquee__item--outline">IoT &amp; EDGE</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item">WEB PLATFORMS</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item marquee__item--outline">CLOUD / DEVEX</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item">STRATEGY &amp; ADVISORY</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item marquee__item--outline">UI / UX</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item">AGRITECH</span>
        <span class="marquee__sep"></span>
        <!-- duplicate for seamless loop -->
        <span class="marquee__item">AI / LLM SYSTEMS</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item marquee__item--outline">IoT &amp; EDGE</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item">WEB PLATFORMS</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item marquee__item--outline">CLOUD / DEVEX</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item">STRATEGY &amp; ADVISORY</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item marquee__item--outline">UI / UX</span>
        <span class="marquee__sep"></span>
        <span class="marquee__item">AGRITECH</span>
        <span class="marquee__sep"></span>
      </div>
    </div>

    <hr class="rule" />

    <!-- ============================================================
         THE X — Why the mark
    ============================================================ -->
    <section class="section">
      <div class="wrap">
        <div class="grid12 x-section">
          <div class="x-left reveal">
            <p class="eyebrow">(01) — THE MARK</p>
            <h2 class="x-headline">Why<br/><span class="flare">X</span></h2>
            <p class="x-subline">
              The X stands for the place where three things meet — and the bet
              that the meeting point matters more than any one of them.
            </p>
          </div>

          <ol class="x-list reveal reveal-d1" role="list">
            <li class="x-item row-invert">
              <span class="x-num numeral">01</span>
              <div class="x-content">
                <h3 class="x-title">Intersection</h3>
                <p class="x-desc row-muted">
                  Where design meets engineering, where strategy meets execution,
                  where human intent meets technical possibility. We live there.
                </p>
              </div>
            </li>
            <li class="x-item row-invert">
              <span class="x-num numeral">02</span>
              <div class="x-content">
                <h3 class="x-title">Multiplier</h3>
                <p class="x-desc row-muted">
                  Technology should multiply human capability — not pile complexity
                  on top of work that was already hard. Every system we ship has to
                  pull its weight.
                </p>
              </div>
            </li>
            <li class="x-item row-invert">
              <span class="x-num numeral">03</span>
              <div class="x-content">
                <h3 class="x-title">Forward</h3>
                <p class="x-desc row-muted">
                  X marks where we're headed. The next problem, the next product,
                  the next genuinely new tool — and the one after that.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ============================================================
         PRINCIPLES
    ============================================================ -->
    <section class="section">
      <div class="wrap">
        <div class="grid12 principles-header-grid">
          <div class="principles-head reveal">
            <p class="eyebrow">(02) — OPERATING PRINCIPLES</p>
            <h2 class="principles-headline">
              Five small commitments<br/>we will not negotiate.
            </h2>
          </div>
        </div>

        <ol class="principles-list" role="list">
          {principles.map((p, i) => (
            <li class={`principle row-invert reveal reveal-d${Math.min(i + 1, 4)}`}>
              <span class="principle-num mono flare">{p.num}</span>
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-desc row-muted">{p.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <hr class="rule" />

    <!-- ============================================================
         MANIFESTO STATEMENT
    ============================================================ -->
    <section class="section manifesto-section">
      <div class="wrap">
        <div class="grid12">
          <div class="manifesto-col reveal">
            <p class="eyebrow">(03) — POINT OF VIEW</p>
            <blockquote class="manifesto-quote">
              Most software is built by people who will never use it, optimised
              for the demo, and shipped when the contract says so.
              <br/><br/>
              We think that's the root cause of most broken products.
              The alternative is smaller teams, harder conversations, and
              shipping something real in the first week.
            </blockquote>
          </div>
          <div class="manifesto-side reveal reveal-d2">
            <p class="manifesto-aside">
              The studio was started in 2024 by Mayur Rawte — a product engineer
              who spent years at the intersection of embedded systems, intelligent
              infrastructure, and product design before deciding the partnership model
              was broken and building a better one.
            </p>
            <p class="manifesto-aside">
              We operate from Bengaluru. We work with teams across IST, GMT, and PST
              without ceremony.
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ============================================================
         OPEN SOURCE CTA
    ============================================================ -->
    <section class="section-sm oss-section">
      <div class="wrap">
        <div class="grid12 oss-inner">
          <div class="oss-text reveal">
            <p class="eyebrow">(04) — OPEN SOURCE</p>
            <h2 class="oss-headline">
              We build in the open,<br/>because closed studios drift.
            </h2>
          </div>
          <div class="oss-actions reveal reveal-d2">
            <p class="oss-note">
              Teamsly, mcp-elements, lit-pigeon, meta-obs — real tools,
              publicly available, MIT-licensed.
            </p>
            <div class="oss-links">
              <a href="/opensource" class="btn">Open-source archive</a>
              <a href="https://github.com/mayurrawte" class="btn" target="_blank" rel="noopener noreferrer">
                GitHub ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .about-hero { padding-top: calc(78px + clamp(4rem, 8vw, 7rem)); }

  .hero-col {
    grid-column: 1 / 10;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-display {
    /* Allow the display headline to bleed a bit past grid edge */
    margin-left: -0.04em;
  }

  .hero-meta {
    grid-column: 10 / -1;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 1rem;
    align-self: end;
  }

  .hero-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .hero-facts li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
    gap: 1rem;
  }
  .hero-facts li:first-child { border-top: 1px solid var(--rule); }
  .fact-val {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink);
  }

  /* ── Stats ────────────────────────────────────────────────── */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .stat-cell {
    padding: clamp(2rem, 3.5vw, 3rem) clamp(1rem, 2vw, 2rem) clamp(2rem, 3.5vw, 3rem) 0;
    border-right: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .stat-cell:last-child { border-right: none; }
  .stat-num {
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.88;
    color: var(--ink);
    display: block;
  }
  .stat-label {
    white-space: pre-line;
    line-height: 1.4;
    color: var(--muted);
  }

  /* ── The X section ────────────────────────────────────────── */
  .x-section {
    align-items: start;
    gap: clamp(2.5rem, 5vw, 5rem);
  }
  .x-left {
    grid-column: 1 / 5;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .x-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
  }
  .x-subline {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 28ch;
  }

  .x-list {
    grid-column: 5 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .x-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    padding: 1.75rem;
    border: 1px solid var(--rule);
    margin-bottom: -1px; /* collapse adjacent hairlines */
    cursor: default;
    transition: background var(--snap), color var(--snap);
  }
  .x-num {
    font-size: 1rem;
    color: var(--flare);
    line-height: 1.5;
    flex-shrink: 0;
  }
  .x-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 0.5rem;
    transition: color var(--snap);
  }
  .x-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0;
    transition: color var(--snap);
  }

  /* ── Principles ───────────────────────────────────────────── */
  .principles-header-grid { margin-bottom: clamp(3rem, 5vw, 5rem); }
  .principles-head { grid-column: 1 / 9; }
  .principles-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin-top: 1.25rem;
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .principle {
    border-bottom: 1px solid var(--rule);
    padding: clamp(1.75rem, 3vw, 2.25rem) 1rem clamp(1.75rem, 3vw, 2.25rem) 0;
    display: grid;
    grid-template-columns: 5rem 1fr 2fr;
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: baseline;
    transition: background var(--snap), color var(--snap);
    cursor: default;
  }
  .principle-num {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--flare);
    padding-top: 0.25rem;
  }
  .principle-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    letter-spacing: -0.025em;
    color: var(--ink);
    transition: color var(--snap);
  }
  .principle-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 55ch;
    transition: color var(--snap);
  }

  /* ── Manifesto ────────────────────────────────────────────── */
  .manifesto-section { background: var(--paper-2); }
  .manifesto-col {
    grid-column: 1 / 8;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .manifesto-quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    border: none;
    padding: 0;
  }

  .manifesto-side {
    grid-column: 9 / -1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-self: end;
    padding-bottom: 0.25rem;
  }
  .manifesto-aside {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0;
  }

  /* ── OSS ──────────────────────────────────────────────────── */
  .oss-section { background: var(--paper); }
  .oss-inner { align-items: end; }
  .oss-text { grid-column: 1 / 8; }
  .oss-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4.5vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-top: 1.25rem;
  }

  .oss-actions {
    grid-column: 9 / -1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .oss-note {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
  .oss-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .stats-row { grid-template-columns: 1fr 1fr; }
    .stat-cell:nth-child(2) { border-right: none; }
    .stat-cell:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
    .stat-cell:nth-child(3) { padding-left: 0; }

    .x-left { grid-column: 1 / -1; }
    .x-list { grid-column: 1 / -1; }

    .manifesto-col { grid-column: 1 / -1; }
    .manifesto-side { grid-column: 1 / -1; align-self: auto; }

    .oss-text { grid-column: 1 / -1; }
    .oss-actions { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
  }

  @media (max-width: 768px) {
    .hero-col { grid-column: 1 / -1; }
    .hero-meta { grid-column: 1 / -1; }
    .principles-head { grid-column: 1 / -1; }

    .principle {
      grid-template-columns: 3.5rem 1fr;
    }
    .principle-desc { grid-column: 2; }

    .stats-row { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .stats-row { grid-template-columns: 1fr; }
    .stat-cell { border-right: none; border-bottom: 1px solid var(--rule); padding-left: 0; }
    .stat-cell:last-child { border-bottom: none; }
  }
</style>
